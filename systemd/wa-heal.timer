[Unit]
Description=Periodically re-assert the omarchy-wa webhook (see wa-heal.service)

[Timer]
# At login (short delay so the session settles) and every 5 minutes after,
# so a crash, a `docker restart`, or a reboot converges without anyone
# needing to notice there was a problem and run wa-up by hand.
OnStartupSec=1min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
