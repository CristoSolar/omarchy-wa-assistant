#!/usr/bin/env python3
# bin/wa-notify
"""Desktop notifications for incoming WhatsApp messages (systemd user service).

Reads new rows from wuzapi's users.db (sink/history.py) whenever the sink
touches state/changed, and raises one notification per chat. Clicking it
summons the chat window on that chat (which does not mark it read).

One notification per chat: we keep the id `notify-send -p` printed for the
chat and pass `-r id` so the next message replaces it. Each notify-send runs
with `-A default=Abrir`, so it stays alive until the notification is clicked
or closed; before spawning the replacement we kill the previous one for that
chat, so there is never more than one listener per chat.

Never sends a message and never writes to wuzapi.
"""
import json
import os
import subprocess
import sys
import threading
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from sink import accounts as accounts_mod, contacts, history, store  # noqa: E402

PLUGIN_ID = "io.github.cristosolar.waassistant"
BODY_MAX = 80
RETRY_SECONDS = 30
ATTACHMENTS = {"image": "📷 Foto", "audio": "🎤 Audio", "video": "🎥 Video",
               "sticker": "Sticker", "document": "📎 Archivo"}


def _bare(jid):
    """'569…:12@s.whatsapp.net' -> '569…@s.whatsapp.net'."""
    user, _, server = str(jid).partition("@")
    return f"{user.split(':')[0]}@{server}"


def should_notify(msg, account, jid, *, enabled_groups, focused, our_ids):
    if msg["from_me"] or focused == f"{account}:{jid}":
        return False
    if not jid.endswith("@g.us") or jid in enabled_groups:
        return True
    return any(_bare(m) in our_ids for m in msg.get("mentions") or [])


def body(msg):
    text = msg["text"] or ATTACHMENTS.get((msg.get("attachment") or {}).get("type"), "")
    return text if len(text) <= BODY_MAX else text[:BODY_MAX - 1] + "…"


def _read_focused(d):
    try:
        return (Path(d) / "focused").read_text().strip()
    except OSError:
        return ""


class Notifier:
    def __init__(self):
        self.live = {}  # (account, jid) -> (notification id, Popen)

    def show(self, key, title, text):
        old = self.live.pop(key, None)
        if old:
            old[1].kill()
            old[1].wait()
        cmd = ["notify-send", "-a", "WhatsApp", "-p", "-A", "default=Abrir", "-i", "dialog-information"]
        if old:
            cmd += ["-r", str(old[0])]
        proc = subprocess.Popen(cmd + ["--", title, text], stdout=subprocess.PIPE, text=True)
        nid = (proc.stdout.readline() or "").strip()
        if not nid.isdigit():
            proc.kill()
            proc.wait()
            return
        self.live[key] = (nid, proc)
        threading.Thread(target=self._listen, args=(key, proc), daemon=True).start()

    @staticmethod
    def _listen(key, proc):
        # Second stdout line is the clicked action; EOF/kill means closed or replaced.
        if (proc.stdout.readline() or "").strip() == "default":
            payload = json.dumps({"account": key[0], "jid": key[1]})
            subprocess.run(["omarchy-shell", "shell", "summon", PLUGIN_ID, payload], check=False)
        proc.wait()


def _title(d, wuzdata, acc, jid, msg):
    if jid.endswith("@g.us"):
        names = store.read_json(Path(d) / "groups.json", {}).get("names", {})
        group = (names.get(acc["id"]) or {}).get(jid)
        return group or "Grupo"
    return contacts.display_name(wuzdata, acc["wuzapi_user"], jid, msg["push_name"])


def process(d, wuzdata, cursor, notifier):
    """Notify for rows after `cursor`; returns the new cursor."""
    accts = accounts_mod.load(d)
    enabled = set(store.load_config(d).get("groups_enabled", []))
    focused = _read_focused(d)
    conn = history.connect(wuzdata)
    try:
        uids = history.user_ids(conn)
        rows = history.rows_after(conn, cursor)
    finally:
        conn.close()
    latest, ours = {}, {}
    for uid, jid, msg in rows:
        cursor = max(cursor, msg["id"])
        acc = next((a for a in accts if uids.get(a["wuzapi_user"]) == uid), None)
        if acc is None:
            continue
        if acc["id"] not in ours:
            ours[acc["id"]] = contacts.our_ids(wuzdata, acc["wuzapi_user"])
        if should_notify(msg, acc["id"], jid, enabled_groups=enabled, focused=focused,
                         our_ids=ours[acc["id"]]):
            latest[(acc["id"], jid)] = (acc, msg)
    for (acc_id, jid), (acc, msg) in latest.items():
        text = body(msg)
        if jid.endswith("@g.us") and msg["push_name"]:
            text = f"{msg['push_name']}: {text}"
        notifier.show((acc_id, jid), _title(d, wuzdata, acc, jid, msg), text)
    return cursor


def _start_cursor(wuzdata):
    conn = history.connect(wuzdata)
    try:
        return history.last_id(conn)
    finally:
        conn.close()


def main():
    d, wuzdata = store.data_dir(), store.wuzdata_dir()
    changed = d / "changed"
    changed.touch(exist_ok=True)
    notifier, cursor = Notifier(), None
    while True:
        try:
            if cursor is None:
                cursor = _start_cursor(wuzdata)  # no backlog flood
            else:
                cursor = process(d, wuzdata, cursor, notifier)
        except Exception as exc:  # users.db missing/locked/SchemaError: retry on next change
            print(f"wa-notify: {type(exc).__name__}: {exc}", file=sys.stderr, flush=True)
            time.sleep(RETRY_SECONDS)
        # Wake on the sink's touch; the timeout is the retry cadence after a failure.
        subprocess.run(["inotifywait", "-qq", "-t", "300", "-e", "close_write,attrib", str(changed)],
                       check=False)


if __name__ == "__main__":
    main()
