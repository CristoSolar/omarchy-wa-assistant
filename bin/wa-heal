#!/usr/bin/env bash
# bin/wa-heal — re-assert the wuzapi webhook when a session is logged in.
#
# wuzapi's webhook registration lives only in memory and is lost on every
# process restart — a crash, `docker restart`, a reboot — even though
# `GET /webhook` (DB-backed) still shows it configured. Nothing re-registers
# it on its own: the sink is passive, and until this script existed the only
# thing that did was `bin/wa-up`'s own self-heal step, and only when a human
# ran `wa-up` by hand.
#
# Left alone, a stack that came back from `--restart unless-stopped` looks
# fully recovered — containers up, `wa-status` reporting
# `ok: true, logged_in: true`, the bar pill showing a healthy state — while
# not one message is actually being delivered. That is a silent failure
# worse than being visibly down, and it is the same class of failure this
# project has already been bitten by once (see StoreReadError in
# sink/store.py).
#
# This script is the single implementation of the re-assert: `wa-up` calls
# it too rather than keeping its own copy, so the two can never drift.
#
# Safe to run repeatedly and often:
#   - no WA_TOKEN yet (never paired)        -> no-op, exit 0
#   - wuzapi unreachable                     -> exit 1, quiet failure, retried
#                                                by the timer next interval
#   - no session logged in                   -> no-op, exit 0
#   - session logged in, webhook re-asserted
#     and confirmed via GET /webhook         -> exit 0
#   - re-assert does not stick (GET /webhook
#     still doesn't match after the POST)    -> exit 1, loud message on stderr
#
# Installed as a systemd --user timer (wa-heal.timer next to this file) that
# runs it every few minutes and once at login, so a crash, a `docker
# restart`, or a reboot converges on its own without anyone having to
# notice there was a problem and run `wa-up` by hand.
set -uo pipefail

STATE="${WA_STATE_ROOT:-$HOME/.local/share/omarchy-wa}"
SECRETS="${WA_SECRETS_FILE:-$STATE/secrets.env}"
API="${WA_API:-http://127.0.0.1:8080}"
WEBHOOK_URL="${WA_WEBHOOK_URL:-http://omarchy-wa-sink:8099}"

if [[ -f "$SECRETS" ]]; then
  # shellcheck disable=SC1090
  source "$SECRETS"
fi
WA_TOKEN="${WA_TOKEN:-}"

if [[ -z "$WA_TOKEN" ]]; then
  echo "wa-heal: no WA_TOKEN yet (not paired) — nothing to heal."
  exit 0
fi

if ! curl -s --max-time 3 "$API/session/status" -H "token: $WA_TOKEN" >/dev/null 2>&1; then
  echo "wa-heal: wuzapi not reachable at $API — skipping this run." >&2
  exit 1
fi

STATUS=$(curl -s --max-time 3 "$API/session/status" -H "token: $WA_TOKEN" 2>/dev/null || true)
LOGGED_IN=$(echo "$STATUS" | python3 -c "
import json, sys
try:
    print('true' if json.load(sys.stdin)['data']['loggedIn'] else 'false')
except Exception:
    print('false')
" 2>/dev/null || echo false)

if [[ "$LOGGED_IN" != "true" ]]; then
  echo "wa-heal: no session logged in — nothing to heal."
  exit 0
fi

curl -s -X POST "$API/webhook" -H "token: $WA_TOKEN" \
  -H "Content-Type: application/json" \
  -d "{\"webhookurl\":\"$WEBHOOK_URL\",\"events\":[\"Message\"]}" >/dev/null

# Verify by reading it back rather than trusting the POST's 200: the whole
# point is that a re-assert can silently not stick.
GOT=$(curl -s --max-time 3 "$API/webhook" -H "token: $WA_TOKEN" \
  | python3 -c "import json,sys; print(json.load(sys.stdin)['data']['webhook'])" 2>/dev/null || echo "")

if [[ "$GOT" == "$WEBHOOK_URL" ]]; then
  echo "wa-heal: webhook healthy ($WEBHOOK_URL)."
  exit 0
fi

echo "wa-heal: FAILED to re-assert the webhook. Messages will NOT be delivered." >&2
echo "  GET /webhook shows: ${GOT:-<unreadable>}" >&2
echo "  expected:           $WEBHOOK_URL" >&2
echo "  Check manually with:" >&2
echo "    curl -s $API/webhook -H \"token: \$WA_TOKEN\"" >&2
exit 1
