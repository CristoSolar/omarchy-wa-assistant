#!/usr/bin/env python3
# bin/wa-reply
"""Draft a WhatsApp reply with claude -p and send it through wuzapi.

The only component in this project that can send a message. It refuses to
send an empty draft, refuses a recipient that is not a full JID, and does
nothing at all unless WA_DRY_RUN is explicitly set to 0.

It is also the component that decides WHICH of the user's numbers a reply
leaves by, and that decision has exactly one source: the queue entry's own
`account` field, written by the sink from the webhook's instanceName when
the message arrived. From it come the token (WA_TOKEN_<ID_UPPER>) and the
tone file. No flag, environment variable or argument can change it, and an
entry naming an account that is not in accounts.json is refused — never
sent under another account, never defaulted to the first one. Answering a
client from the personal number is the failure this closes by
construction, the same way the full-JID check closes writing to the wrong
person.
"""
import argparse
import hashlib
import json
import os
import re
import socket
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from sink import accounts, store  # noqa: E402

API = os.environ.get("WA_API", "http://127.0.0.1:8080")
AGENTS_DIR = Path(__file__).resolve().parents[1] / "agents"
DEFAULT_AGENT_FILE = "respuesta.md"
# Not anchored: a real `claude -p` reply often wraps the fenced block in a
# preamble ("Claro, aca va:\n```\nHola\n```"), and the backticks must never
# reach the recipient.
FENCE = re.compile(r"```[^\n]*\n(.*?)\n?```", re.S)


# Statuses whose entry may ALREADY have reached the recipient, and which
# therefore must not be re-sent without a human saying they checked.
#   unknown — the POST timed out or the connection dropped mid-request.
#   sending — wa-reply was killed between writing this and finishing the
#             POST (a bar restart, a logout, an OOM kill). The request may
#             have completed on wuzapi's side; nothing recorded the answer.
UNCONFIRMED_STATUSES = ("unknown", "sending")

NEEDS_ACK_MESSAGE = {
    "unknown": ("este envío quedó sin confirmación: el mensaje puede haberse "
                "enviado ya. Revisá WhatsApp y confirmá antes de reintentar "
                "(--acknowledged)."),
    "sending": ("un envío anterior de esta entrada quedó interrumpido a mitad "
                "de camino: el mensaje puede haberse enviado ya. Revisá "
                "WhatsApp y confirmá antes de reintentar (--acknowledged)."),
}


class SendOutcomeUnknown(Exception):
    """The request may or may not have reached wuzapi.

    Raised on a timeout or connection error, where the message could
    already have been delivered. Never treat this the same as a definite
    failure: a caller that reacts by resending risks a double-send to a
    real person.
    """


class ReplyRefused(Exception):
    """A refusal that must be reported and must never become a send.

    Carries the exact JSON object main() prints on stdout before exiting
    non-zero, so every refusal looks like every other failure in this
    script: one line of JSON, nothing on the network.
    """

    def __init__(self, payload: dict):
        self.payload = payload
        super().__init__(payload.get("error", "refused"))


class UnknownAccount(ReplyRefused):
    """The entry's `account` is not in accounts.json.

    Deliberately distinct from MissingToken: this one means the entry is
    stale (its account was renamed or removed) or accounts.json is wrong,
    and the fix is on the accounts side. Never resolvable by picking some
    other account — that is exactly how a client would get answered from
    the personal number.
    """

    def __init__(self, account_id):
        super().__init__({
            "ok": False,
            "unknown_account": account_id,
            "error": (f"la entrada dice cuenta {account_id!r} y esa cuenta no "
                      f"está en accounts.json; no se envía nada. Revisá "
                      f"accounts.json o descartá la entrada."),
        })


class MissingToken(ReplyRefused):
    """The account exists but secrets.env has no token for it.

    Distinct from UnknownAccount: the accounts file is fine, the
    credential is not there — pairing never finished, or secrets.env was
    rewritten. The fix is `wa-pair <cuenta>`, not editing accounts.json.
    """

    def __init__(self, account_id, var):
        super().__init__({
            "ok": False,
            "missing_token": var,
            "account": account_id,
            "error": (f"la cuenta {account_id!r} existe pero secrets.env no "
                      f"tiene {var}; no se envía nada. Vinculá esa cuenta "
                      f"(wa-pair) o restaurá el secreto."),
        })


class AccountNotStated(UnknownAccount):
    """The entry does not say which account it arrived on.

    A pre-migration entry that somehow survived, or a hand-edited queue.
    Same family as UnknownAccount — there is no account to answer from and
    guessing one is the forbidden move — but the message has to name a
    fixable cause instead of reading "cuenta None".
    """

    def __init__(self, entry_id=None):
        which = f" ({entry_id})" if entry_id else ""
        ReplyRefused.__init__(self, {
            "ok": False,
            "unknown_account": None,
            "error": (f"la entrada{which} no dice de qué cuenta es, así que no "
                      f"hay número desde el cual contestar; no se envía nada. "
                      f"Es una entrada anterior a la migración: corré wa-up "
                      f"(que migra) o descartála."),
        })


class UnknownAccountId(ReplyRefused):
    """A settings subcommand was asked about an account id that does not exist.

    Distinct from UnknownAccount: that one is reached from a QUEUE ENTRY
    whose `account` field names a stale or wrong id. This one is reached
    from the settings screen, which asks for an account id directly (no
    entry involved) — wrong id, typo, or an account removed by wa-unlink
    while the settings screen was still open. Same family (never guess a
    different account), different caller, so a different, entry-free
    message.
    """

    def __init__(self, account_id):
        super().__init__({
            "ok": False,
            "unknown_account": account_id,
            "error": (f"no existe una cuenta {account_id!r} en accounts.json; "
                      f"no se lee ni se escribe nada."),
        })


class InvalidQuickReplies(ReplyRefused):
    """The proposed quick-reply list is not a list of non-empty strings.

    A tone file is free text — this script does not judge its content.
    quick_replies is structured data the panel renders as buttons, and an
    empty button or a non-string element is not a "weird but valid" quick
    reply, it is a broken one. Refuse before writing rather than saving
    something the panel could later crash on rendering.
    """

    def __init__(self, reason: str):
        super().__init__({
            "ok": False,
            "error": (f"lista de respuestas rápidas inválida: {reason}; no se "
                      f"escribió nada."),
        })


class ToneConflict(ReplyRefused):
    """The tone file changed on disk since the caller last read it.

    agents/<account>.md is explicitly a file people edit by hand (see the
    module docstring's design note) while the settings screen might be
    holding a copy read minutes earlier. Writing blindly would silently
    destroy that hand edit with no trace — worse than refusing, because
    the person would not even know to look for their lost text. Refuse
    instead: nothing is written, and the message says why and what to do.
    """

    def __init__(self, account_id):
        super().__init__({
            "ok": False,
            "conflict": True,
            "account": account_id,
            "error": (f"el tono de la cuenta {account_id!r} cambió en disco "
                      f"desde que se leyó — alguien lo editó a mano (o desde "
                      f"otra ventana) mientras tanto. No se escribió nada, "
                      f"para no perder ese cambio. Volvé a abrir el tono "
                      f"actual, guardá tu texto aparte y aplicalo de nuevo "
                      f"sobre la versión que hay ahora."),
        })


class QuickRepliesConflict(ReplyRefused):
    """accounts.json changed on disk since the caller last read it.

    Same reasoning as ToneConflict, but the shared file is accounts.json:
    a person can be editing quick_replies (or anything else in that file)
    by hand while the settings screen holds an older copy. Refuse rather
    than overwrite the rest of the file with a stale snapshot.
    """

    def __init__(self, account_id):
        super().__init__({
            "ok": False,
            "conflict": True,
            "account": account_id,
            "error": (f"accounts.json cambió en disco desde que se leyeron las "
                      f"respuestas rápidas de {account_id!r} — alguien lo editó "
                      f"a mano (o desde otra ventana) mientras tanto. No se "
                      f"escribió nada. Volvé a cargar la lista actual y aplicá "
                      f"tu cambio de nuevo sobre ella."),
        })


# The single definition of the token variable's name now lives in
# sink/accounts.py (token_env_var): bin/wa-status needs it too, polled
# every few seconds by the bar widget once per configured account, so it
# cannot afford to shell out to `wa-reply token-var` per account per poll —
# it imports sink.accounts directly instead. This name is a reference to
# that one function, not a second copy of it, kept so every existing
# `wa.token_env_var(...)` call (here and in tests) still works unchanged.
token_env_var = accounts.token_env_var


def resolve_account(d, entry) -> dict:
    """The account an entry belongs to, from the entry alone.

    The `account` field was written by the sink when the message arrived,
    from the webhook's own instanceName. Nothing else — no flag, no
    environment variable, no argument — may select it, and an account that
    is not configured is refused rather than defaulted: answering from the
    wrong number is the failure this whole design exists to make
    impossible.
    """
    account_id = (entry or {}).get("account")
    if not account_id:
        raise AccountNotStated((entry or {}).get("id"))
    account = accounts.by_id(accounts.load(d), account_id)
    if account is None:
        raise UnknownAccount(account_id)
    return account


def account_token(account) -> str:
    """The sending token for a resolved account, from secrets.env."""
    account_id = account["id"]
    var = token_env_var(account_id)
    _load_secrets()
    try:
        return os.environ[var]
    except KeyError:
        raise MissingToken(account_id, var) from None


def agent_path(account) -> Path:
    """The tone file of this account, under the plugin's agents/.

    `.name` keeps a stray path in accounts.json from reaching outside
    agents/; the tone file is plugin content, not an arbitrary path.
    """
    return AGENTS_DIR / Path(account.get("agent") or DEFAULT_AGENT_FILE).name


def _load_secrets() -> None:
    """Read secrets.env into the environment when it is not already there.

    QML's Process spawns this script with a bare environment, so WA_TOKEN
    written by wa-up would otherwise never reach us.

    The path comes from store.secrets_path(), which is resolved from
    WA_SECRETS_FILE / the state root — not from WA_DATA_DIR, which now
    points at the directory bind-mounted into the sink container.
    """
    path = store.secrets_path()
    try:
        lines = path.read_text().splitlines()
    except OSError:
        return
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        os.environ.setdefault(key.strip(), value.strip())


def clean_draft(raw: str) -> str:
    raw = raw or ""
    m = FENCE.search(raw)
    return (m.group(1) if m else raw).strip()


def build_prompt(agent_text, context, idea, push_name) -> str:
    lines = [f"{c.get('from', '?')}: {c.get('text', '')}" for c in context]
    return (
        f"{agent_text}\n\n"
        f"Estás redactando una respuesta de WhatsApp para {push_name}.\n\n"
        f"Últimos mensajes del chat:\n" + ("\n".join(lines) or "(sin contexto)") +
        f"\n\nLa idea que hay que transmitir:\n{idea}\n\n"
        "Devolvé únicamente el texto del mensaje, sin comillas ni explicaciones."
    )


def _post(url, payload, token):
    req = urllib.request.Request(
        url, data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json", "token": token})
    try:
        with urllib.request.urlopen(req, timeout=20) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError:
        # The server answered (with an error status): that is a definite
        # outcome, not an unknown one.
        raise
    except (TimeoutError, socket.timeout, urllib.error.URLError,
            ConnectionError) as exc:
        raise SendOutcomeUnknown(str(exc)) from exc


def _is_confirmed_sent(result) -> bool:
    """True only for a response that proves the message went out.

    A dry run is deliberately NOT confirmed here: it never touched the
    network, so nothing about the queue entry may be treated as done.
    Callers handle `dry_run` before asking this question.

    Tolerates any shape wuzapi might return — including a `data` field that
    is `null` instead of a dict — so a surprising response never crashes
    the caller and strands the queue entry in status "sending".
    """
    if not isinstance(result, dict):
        return False
    data = result.get("data")
    return isinstance(data, dict) and data.get("Details") == "Sent"


def _is_dry_run(result) -> bool:
    return isinstance(result, dict) and bool(result.get("dry_run"))


def send(jid: str, text: str, token: str) -> dict:
    """POST one message. The token is the caller's, already resolved.

    `token` is not optional and is never looked up here: cmd_send derives
    it from the queue entry's own account (account_token) before this
    function is reached, so there is exactly one place where an identity
    is chosen and it is the entry. A token argument also means this
    function cannot silently fall back to a "default" account the way a
    lookup of a fixed WA_TOKEN could.

    _load_secrets() already ran during that derivation, so WA_DRY_RUN
    coming from secrets.env is in the environment by the time it is read
    below — still read at exactly one place, still defaulting to a dry
    run when it is absent.
    """
    text = (text or "").strip()
    if not text:
        raise ValueError("refusing to send an empty draft")
    if "@" not in (jid or ""):
        raise ValueError(
            "recipient must be a full JID with '@'; a bare number is ambiguous")
    if not API.startswith("http://127.0.0.1:"):
        raise ValueError(
            f"refusing to send: WA_API must stay on 127.0.0.1, got {API!r}")
    if os.environ.get("WA_DRY_RUN", "1") != "0":
        return {"dry_run": True, "jid": jid, "text": text}
    if not token:
        raise ValueError("refusing to send without a token")
    return _post(f"{API}/chat/send/text", {"Phone": jid, "Body": text}, token)


def _entry(d, entry_id):
    for e in store.load_queue(d):
        if e["id"] == entry_id:
            return e
    return None


def _sha256_bytes(data: bytes) -> str:
    """The clobber-protection token handed out by every settings read.

    A content hash, not a modification time: two edits inside the same
    wall-clock second are ordinary here (a person typing into an editor,
    then the settings screen saving) and many filesystems only keep
    mtime to one-second resolution, so an mtime check can miss exactly
    the overlap it exists to catch. A hash of the bytes actually on disk
    only ever agrees when the bytes are unchanged, whatever the clock
    says — and it survives round-tripping through JSON as a plain string,
    which an mtime float would not do as cleanly across the CLI boundary.
    """
    return hashlib.sha256(data).hexdigest()


def _read_bytes_or_empty(path: Path) -> bytes:
    """A file's raw bytes, or b"" when it does not exist yet.

    A tone file or accounts.json that has never been written reads as
    empty rather than raising: a fresh account or one whose tone file was
    never created is a legitimate starting point, not a broken install
    (the same stance store.read_json takes for a missing state file).
    """
    try:
        return path.read_bytes()
    except FileNotFoundError:
        return b""


def _account_or_refuse(d, account_id) -> dict:
    """An account by id, for the settings subcommands (no queue entry involved).

    Distinct from resolve_account: that one starts from a queue entry and
    raises UnknownAccount/AccountNotStated with entry-shaped messages. The
    settings screen names an account id directly, so a miss here is
    UnknownAccountId instead — same refuse-rather-than-guess stance, a
    message that fits how this caller actually got here.
    """
    account = accounts.by_id(accounts.load(d), account_id)
    if account is None:
        raise UnknownAccountId(account_id)
    return account


def _validate_quick_replies(value):
    """Raise InvalidQuickReplies unless value is a list of non-empty strings.

    Whitespace-only counts as empty, the same stance the send path takes
    on an empty draft (`text.strip()`): a button with nothing visible on
    it is not a valid quick reply. An empty LIST is fine — "no quick
    replies configured" is a normal state, not an error.
    """
    if not isinstance(value, list):
        raise InvalidQuickReplies(
            f"se esperaba una lista, se recibió {type(value).__name__}")
    for i, item in enumerate(value):
        if not isinstance(item, str) or not item.strip():
            raise InvalidQuickReplies(
                f"el elemento {i} no es un texto no vacío: {item!r}")
    return value


def cmd_token_var(args):
    """Print the name of an account's token variable, for bin/wa-pair.

    Not part of the panel's interface: it exists so the script that WRITES
    the token into secrets.env derives its name from token_env_var() here
    instead of building the same string a second time in bash. It prints a
    variable NAME, never a value.

    token_env_var validates the charset, so this can only ever print a
    legal shell identifier: the output is substituted unquoted into bash
    in wa-pair, and an id like `a b; echo x` or `mi-trabajo` must fail
    here rather than become part of a command line. It deliberately does
    NOT require the account to exist yet — wa-pair names an account before
    creating it.
    """
    try:
        print(token_env_var(args.account_id))
    except ValueError as exc:
        # Refused on stderr and with a non-zero exit, and nothing on
        # stdout: a bash caller doing VAR=$(wa-reply token-var "$1") must
        # get an empty capture and a failing status, never a fragment.
        print(f"wa-reply: {exc}", file=sys.stderr)
        sys.exit(1)


def cmd_list(args):
    print(json.dumps(store.load_queue(store.data_dir()), ensure_ascii=False))


def cmd_accounts(args):
    """The configured accounts' `id` and `label` — nothing else.

    Exists so Panel.qml can label a queue entry's `account` field (a
    badge in the list, and the "sale desde" line in the detail view)
    without the queue ever carrying a denormalised copy of the label
    itself. A copy on the entry could disagree with a later rename in
    accounts.json; asking here every refresh cannot. Deliberately leaves
    out `wuzapi_user`, `agent` and `quick_replies` — none of that is the
    panel's business, and `quick_replies` already has its own accessor
    (`quick <id>`) scoped to one entry's account.

    Like `list`, a StoreReadError (corrupt accounts.json) propagates to
    main()'s handler rather than being swallowed here, so a broken
    install prints the same `{"ok": false, "error": ...}` shape as every
    other subcommand instead of a silent empty array.
    """
    accts = accounts.load(store.data_dir())
    print(json.dumps(
        [{"id": a.get("id"), "label": a.get("label") or a.get("id")}
         for a in accts],
        ensure_ascii=False))


def cmd_quick(args):
    """The quick replies of the account the given entry belongs to.

    It takes the SAME entry id the panel passes to `draft` and `send`,
    not an account: the panel already knows which entry it is showing,
    and deriving the account from the entry here (rather than letting the
    caller name one) keeps every account decision in this script coming
    from the one place the invariant allows. A stale id is the same
    normal race cmd_draft/cmd_send handle; an unknown account is refused
    like everywhere else.
    """
    d = store.data_dir()
    entry = _entry(d, args.id)
    if entry is None:
        # Always an ARRAY on stdout, in every outcome: the panel binds this
        # output straight to its quick-reply list, and a JSON object here
        # (the shape the other subcommands use for an error) would be a
        # second shape it has to know about. The exit code carries the
        # failure instead — the empty list is "no buttons", not "this
        # account has no quick replies".
        print("[]")
        print(f"wa-reply: no queue entry with id {args.id}", file=sys.stderr)
        sys.exit(1)
    account = resolve_account(d, entry)
    quick = account.get("quick_replies", [])
    print(json.dumps(quick if isinstance(quick, list) else [], ensure_ascii=False))


def cmd_tone_get(args):
    """The tone file text of one account, plus a hash to hand back on write.

    Read-only, for the settings screen. Prints only what was asked for —
    the account id, the text and its hash — never the rest of the account
    (wuzapi_user, agent path, quick_replies, a token): the same allowlist
    stance cmd_accounts already takes, for the same reason.
    """
    d = store.data_dir()
    account = _account_or_refuse(d, args.account_id)
    data = _read_bytes_or_empty(agent_path(account))
    print(json.dumps({
        "ok": True,
        "account": account["id"],
        "text": data.decode("utf-8", errors="replace"),
        "hash": _sha256_bytes(data),
    }, ensure_ascii=False))


def cmd_tone_set(args):
    """Save an account's tone text, refusing a write over a hand edit.

    `--hash` must be the hash cmd_tone_get returned for this same file;
    a mismatch means the file changed since it was read (someone editing
    it by hand, most likely) and the write is refused outright rather
    than merged or overwritten — see ToneConflict. The text itself is
    never validated: it is a prompt, and judging its content is not this
    script's job, unlike quick_replies which the panel renders as
    buttons.
    """
    d = store.data_dir()
    account = _account_or_refuse(d, args.account_id)
    path = agent_path(account)
    current = _read_bytes_or_empty(path)
    if _sha256_bytes(current) != args.hash:
        raise ToneConflict(account["id"])
    new_text = args.text or ""
    store.atomic_write(path, new_text)
    print(json.dumps({
        "ok": True,
        "account": account["id"],
        "hash": _sha256_bytes(new_text.encode("utf-8")),
    }, ensure_ascii=False))


def cmd_quick_get(args):
    """An account's quick_replies, plus a hash of accounts.json to write back.

    Unlike `quick` (keyed by a queue entry, for the panel's active-chat
    view), this takes the account id directly — the settings screen edits
    an account, not a chat. Prints only the account id, its list and the
    hash: never wuzapi_user, agent or another account's entry, the same
    allowlist stance as cmd_accounts.
    """
    d = store.data_dir()
    path = Path(d) / "accounts.json"
    data = _read_bytes_or_empty(path)
    account = _account_or_refuse(d, args.account_id)
    quick = account.get("quick_replies", [])
    print(json.dumps({
        "ok": True,
        "account": account["id"],
        "quick_replies": quick if isinstance(quick, list) else [],
        "hash": _sha256_bytes(data),
    }, ensure_ascii=False))


def cmd_quick_set(args):
    """Save an account's quick_replies, refusing a stale or invalid write.

    Two independent refusals, checked in this order: the shape of
    `--replies` (a JSON array of non-empty strings, InvalidQuickReplies
    otherwise) and, separately, whether accounts.json is still the file
    `--hash` was taken from (QuickRepliesConflict otherwise) — a hand
    edit to accounts.json, or to another account's field, since the
    settings screen last read it. Only when both hold does this touch the
    file, and even then it rewrites just this account's quick_replies
    inside the freshly-loaded list, never a stale in-memory copy of the
    other accounts.
    """
    d = store.data_dir()
    try:
        replies = json.loads(args.replies)
    except ValueError as exc:
        raise InvalidQuickReplies(f"no es JSON válido: {exc}") from None
    replies = _validate_quick_replies(replies)

    path = Path(d) / "accounts.json"
    current = _read_bytes_or_empty(path)
    if _sha256_bytes(current) != args.hash:
        raise QuickRepliesConflict(args.account_id)

    accts = accounts.load(d)
    account = accounts.by_id(accts, args.account_id)
    if account is None:
        raise UnknownAccountId(args.account_id)
    account["quick_replies"] = replies
    new_text = json.dumps(accts, ensure_ascii=False)
    store.atomic_write(path, new_text)
    print(json.dumps({
        "ok": True,
        "account": args.account_id,
        "quick_replies": replies,
        "hash": _sha256_bytes(new_text.encode("utf-8")),
    }, ensure_ascii=False))


def cmd_draft(args):
    d = store.data_dir()
    entry = _entry(d, args.id)
    if entry is None:
        # A stale id is a normal race, not a bug: the panel holds a queue
        # snapshot that a new message or a completed send can change
        # between `list` and `draft`.
        print(json.dumps({"ok": False, "error": f"no queue entry with id {args.id}"},
                         ensure_ascii=False))
        return
    account = resolve_account(d, entry)
    agent_file = agent_path(account)
    agent_text = agent_file.read_text() if agent_file.exists() else ""
    prompt = build_prompt(agent_text,
                          store.load_context(d, entry["jid"], account["id"]),
                          args.idea, entry["push_name"])
    try:
        out = subprocess.run(["claude", "-p", prompt], capture_output=True,
                             text=True, timeout=120)
        if out.returncode != 0:
            draft, error = "", (out.stderr or "claude failed").strip()
        else:
            draft = clean_draft(out.stdout)
            # A clean exit with nothing on stdout used to give the panel an
            # empty draft AND an empty error, i.e. a blank box with no
            # explanation. Say what happened instead.
            error = "" if draft else (
                (out.stderr or "").strip()
                or "claude devolvió una respuesta vacía; escribí la respuesta a mano")
    except (OSError, subprocess.TimeoutExpired) as exc:
        draft, error = "", str(exc)
    print(json.dumps({"draft": draft, "error": error}, ensure_ascii=False))


def cmd_send(args):
    d = store.data_dir()
    entry = _entry(d, args.id)
    if entry is None:
        # Same race as cmd_draft: the entry may already be gone.
        print(json.dumps({"ok": False, "error": f"no queue entry with id {args.id}"},
                         ensure_ascii=False))
        return

    # The durable record is authoritative. An entry left at "unknown" or
    # stranded at "sending" may ALREADY have reached the recipient; the QML
    # guard that used to be the only thing standing here is volatile and a
    # bar restart clears it. Refuse until the caller says, explicitly, that
    # the human checked WhatsApp.
    status_at_start = entry.get("status")
    if (status_at_start in UNCONFIRMED_STATUSES
            and not getattr(args, "acknowledged", False)):
        print(json.dumps({
            "ok": False, "needs_ack": True,
            "status": status_at_start,
            "error": NEEDS_ACK_MESSAGE[status_at_start],
        }, ensure_ascii=False))
        return

    # I3: a message that arrives while the draft is being written bumps the
    # entry's ts (and count). Removing the entry on success would destroy
    # it silently and the user would never learn it existed.
    ts_at_start = entry.get("ts")

    # The identity decision, made before anything is written or sent and
    # made only from the entry. Both refusals raise out of here, so a
    # refused entry is never even marked "sending" — it is left exactly as
    # it was found, and nothing reaches the network.
    account = resolve_account(d, entry)
    token = account_token(account)

    store.set_status(d, entry["id"], "sending")
    # Flipped the instant the response proves the message reached the
    # recipient. Everything after that point is bookkeeping, and no
    # bookkeeping failure may leave the entry in a status a second send
    # can consume without an acknowledgement. See the generic handler.
    confirmed_sent = False
    try:
        result = send(entry["jid"], args.text, token)
        if _is_dry_run(result):
            # A dry run sent nothing, so it must change nothing — including
            # the guard. Writing a literal "pending" here erased a stored
            # "unknown"/"sending" and permanently dropped the double-send
            # protection for an entry nothing was ever sent for. Put back
            # exactly the status the entry had.
            store.set_status(d, entry["id"], status_at_start)
            print(json.dumps({"ok": True, "dry_run": True}, ensure_ascii=False))
        elif _is_confirmed_sent(result):
            confirmed_sent = True
            fresh = _entry(d, entry["id"])
            if fresh is not None and fresh.get("ts") != ts_at_start:
                store.set_status(d, entry["id"], "pending")
                print(json.dumps({"ok": True, "dry_run": False, "superseded": True},
                                 ensure_ascii=False))
            else:
                store.remove_queue(d, entry["id"])
                print(json.dumps({"ok": True, "dry_run": False}, ensure_ascii=False))
        else:
            store.set_status(d, entry["id"], "failed")
            print(json.dumps({"ok": False,
                              "error": json.dumps(result, ensure_ascii=False)},
                             ensure_ascii=False))
    except SendOutcomeUnknown as exc:
        # The request may have reached wuzapi before the timeout/connection
        # error hit. Do not mark this "failed" — that invites a retry that
        # sends the same message twice to a real person. Surface "unknown"
        # so the panel can tell the user to check WhatsApp first, and so a
        # later cmd_send on this entry refuses without an acknowledgement.
        store.set_status(d, entry["id"], "unknown")
        print(json.dumps({"ok": False, "unknown": True, "error": str(exc)},
                         ensure_ascii=False))
    except Exception as exc:
        if confirmed_sent:
            # The message DID reach the recipient; only the bookkeeping
            # after it failed (remove_queue hitting a read-only state dir,
            # a corrupted queue.json, a disk full). "failed" carries no
            # acknowledgement requirement, so it would light both send
            # paths back up — panel says "falló", one click sends the same
            # message to a real person a second time. "unknown" is the
            # weakest statement that is still true here: it went out, and
            # what is on disk about it cannot be trusted. It is in
            # UNCONFIRMED_STATUSES, so the next cmd_send refuses without
            # --acknowledged and the panel keeps its guard.
            try:
                store.set_status(d, entry["id"], "unknown")
            except Exception:
                # Writing the status is the very thing that just failed;
                # do not let a second failure hide the outcome from the
                # caller. The panel treats an unparseable response as
                # equally unsendable (sendBlocked), so the guard holds
                # either way.
                pass
            print(json.dumps({
                "ok": False, "unknown": True,
                "error": f"el mensaje SE ENVIÓ, pero no se pudo actualizar la "
                         f"cola después: {exc}",
            }, ensure_ascii=False))
            return
        store.set_status(d, entry["id"], "failed")
        print(json.dumps({"ok": False, "error": str(exc)}, ensure_ascii=False))


def main():
    ap = argparse.ArgumentParser()
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list").set_defaults(fn=cmd_list)
    sub.add_parser("accounts").set_defaults(fn=cmd_accounts)
    p = sub.add_parser("quick"); p.add_argument("id")
    p.set_defaults(fn=cmd_quick)
    p = sub.add_parser("tone-get"); p.add_argument("account_id")
    p.set_defaults(fn=cmd_tone_get)
    p = sub.add_parser("tone-set"); p.add_argument("account_id")
    p.add_argument("--text", required=True)
    p.add_argument("--hash", required=True)
    p.set_defaults(fn=cmd_tone_set)
    p = sub.add_parser("quick-get"); p.add_argument("account_id")
    p.set_defaults(fn=cmd_quick_get)
    p = sub.add_parser("quick-set"); p.add_argument("account_id")
    p.add_argument("--replies", required=True)
    p.add_argument("--hash", required=True)
    p.set_defaults(fn=cmd_quick_set)
    p = sub.add_parser("token-var"); p.add_argument("account_id")
    p.set_defaults(fn=cmd_token_var)
    p = sub.add_parser("draft"); p.add_argument("id"); p.add_argument("--idea", required=True)
    p.set_defaults(fn=cmd_draft)
    p = sub.add_parser("send"); p.add_argument("id"); p.add_argument("--text", required=True)
    p.add_argument("--acknowledged", action="store_true",
                   help="the user confirmed they checked WhatsApp after an "
                        "unconfirmed ('unknown') send; required to retry one")
    p.set_defaults(fn=cmd_send)
    args = ap.parse_args()
    try:
        args.fn(args)
    except ReplyRefused as exc:
        # An account this install cannot send as. One line of JSON on
        # stdout like every other failure here, a human-readable line on
        # stderr, and a non-zero exit — never a send under some other
        # account, never a default.
        print(f"wa-reply: {exc}", file=sys.stderr)
        print(json.dumps(exc.payload, ensure_ascii=False))
        sys.exit(1)
    except store.StoreReadError as exc:
        # A state file exists but could not be read (permissions, usually a
        # root-owned queue.json from before the sink ran as the invoking
        # user) or is not valid JSON. This is a broken install, not an
        # empty queue, and must never look like one: `list` must not print
        # a bare `[]` (Panel.qml would render that as an empty queue) and
        # `draft`/`send` must not look like a normal empty result either.
        # Say so on stderr, where a human running this by hand will see
        # it, and print a JSON object (never an array, never blank) so
        # nothing downstream can mistake this for "nothing queued".
        print(f"wa-reply: {exc}", file=sys.stderr)
        print(f"wa-reply: fix with: docker exec omarchy-wa-sink chown -R "
              f"$(id -u):$(id -g) /state   (or re-run wa-up, which now "
              f"detects and repairs this)", file=sys.stderr)
        print(json.dumps({"ok": False, "error": str(exc)}, ensure_ascii=False))
        sys.exit(1)


if __name__ == "__main__":
    main()
