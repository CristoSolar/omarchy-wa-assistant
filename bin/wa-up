#!/usr/bin/env bash
# bin/wa-up — bring the bridge and the sink up.
# wuzapi is published on loopback only; the sink publishes nothing.
#
# Layout (see sink/store.py for the same comment):
#   $STATE/              0700, host only
#     secrets.env        0600 — NEVER mounted into a container
#     state/             queue.json, ctx/, config.json -> mounted at /state
#     wuzdata/           wuzapi's SQLite          -> mounted at /wuzdata
# The sink is the internet-facing side. It must not be handed the API token
# as well as the network route; keeping secrets.env out of its mounts makes
# that boundary structural rather than a property of the sink's imports.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE="${WA_STATE_ROOT:-$HOME/.local/share/omarchy-wa}"
SECRETS="${WA_SECRETS_FILE:-$STATE/secrets.env}"
DATA="${WA_DATA_DIR:-$STATE/state}"
mkdir -p "$DATA/ctx" "$STATE/wuzdata"
chmod 700 "$STATE" "$DATA"

# The sink used to run as root (uid 0) inside the container. Its bind
# mounts are the invoking user's directories, so everything it wrote —
# queue.json, ctx/*.json, config.json — landed root-owned. `tempfile.
# mkstemp` also makes new files mode 0600, so the invoking user (uid 1000)
# could not even read them: `wa-reply list` printed `[]`, `wa-status` said
# `pending: 0`, and the widget stayed hidden, all while the sink was
# working correctly. The sink now runs as the invoking user (see the
# `docker run --user` below), but an existing install may still have
# root-owned files left over from before this fix. Detect and repair those
# now, before anything is (re)started, instead of silently leaving a
# broken install running.
mapfile -t UNREADABLE < <(find "$DATA" "$STATE/wuzdata" -type f \
  \( ! -readable -o ! -writable \) 2>/dev/null)
if [[ ${#UNREADABLE[@]} -gt 0 ]]; then
  echo "found ${#UNREADABLE[@]} state file(s) not readable/writable by " \
       "$(id -u):$(id -g) — likely root-owned from a sink that ran as root " \
       "before this fix. Repairing..." >&2
  if docker run --rm -v "$DATA:/state" -v "$STATE/wuzdata:/wuzdata" \
       python:3.12-alpine chown -R "$(id -u):$(id -g)" /state /wuzdata \
       >/dev/null 2>&1; then
    echo "repaired ownership of $DATA and $STATE/wuzdata" >&2
  else
    echo "could not repair automatically. Run this yourself, then re-run wa-up:" >&2
    echo "  docker run --rm -v \"$DATA:/state\" -v \"$STATE/wuzdata:/wuzdata\" \\" >&2
    echo "    python:3.12-alpine chown -R \$(id -u):\$(id -g) /state /wuzdata" >&2
    exit 1
  fi
fi

# Migrate the pre-split layout, where the sink-visible files sat next to
# secrets.env at the state root.
for f in queue.json config.json; do
  if [[ -f "$STATE/$f" && ! -e "$DATA/$f" ]]; then
    mv "$STATE/$f" "$DATA/$f"
    echo "moved $f into $DATA/"
  fi
done
if [[ -d "$STATE/ctx" && "$STATE/ctx" != "$DATA/ctx" ]]; then
  if compgen -G "$STATE/ctx/*.json" >/dev/null; then
    mv "$STATE"/ctx/*.json "$DATA/ctx/"
    echo "moved per-chat context into $DATA/ctx/"
  fi
  rmdir "$STATE/ctx" 2>/dev/null || true
fi

# Seed quick_replies on first run, or on an existing config.json that
# predates this key. Never overwrites or reorders an existing list, and
# never touches groups_enabled or any other key already there. A
# config.json that exists but cannot be read/parsed is left alone here —
# that is a broken install for wa-reply/wa-status to surface loudly, not
# something wa-up should silently paper over by rewriting it.
PYTHONPATH="$ROOT" python3 - "$DATA" <<'PYEOF'
import json
import sys
from pathlib import Path
from sink import store

d = Path(sys.argv[1])
try:
    cfg = store.load_config(d)
except store.StoreReadError:
    sys.exit(0)
if "quick_replies" not in cfg:
    cfg["quick_replies"] = [
        "Hola, soy el asistente AI de Cristóbal, en estos momentos no puede "
        "responder pero responderá en breve."
    ]
    store.atomic_write(d / "config.json", json.dumps(cfg, ensure_ascii=False))
    print("seeded quick_replies default in config.json")
PYEOF

if [[ ! -f "$SECRETS" ]]; then
  mkdir -p "$(dirname "$SECRETS")"
  {
    echo "WUZAPI_ADMIN_TOKEN=$(openssl rand -hex 16)"
    echo "WUZAPI_GLOBAL_ENCRYPTION_KEY=$(openssl rand -hex 16)"
    echo "WA_TOKEN=$(openssl rand -hex 12)"
  } > "$SECRETS"
  chmod 600 "$SECRETS"
fi
# shellcheck disable=SC1090
source "$SECRETS"

docker network create omarchy-wa >/dev/null 2>&1 || true

if ! docker image inspect omarchy-wa-sink >/dev/null 2>&1; then
  docker build -t omarchy-wa-sink -f "$ROOT/docker/sink.Dockerfile" "$ROOT"
fi

if ! docker image inspect omarchy-wuzapi >/dev/null 2>&1; then
  echo "Missing image omarchy-wuzapi. Build it from asternic/wuzapi:" >&2
  echo "  git clone --depth 1 https://github.com/asternic/wuzapi /tmp/wuzapi" >&2
  echo "  docker build -t omarchy-wuzapi /tmp/wuzapi" >&2
  exit 1
fi

docker rm -f omarchy-wuzapi omarchy-wa-sink >/dev/null 2>&1 || true

# --restart unless-stopped: bring both containers back after a crash or a
# host reboot without needing wa-up run by hand. Not `always` — this stack
# holds a live link to the person's personal WhatsApp session, so a
# deliberate `docker stop` must stay stopped, not resurrect itself on the
# next boot. This alone does not bring the stack back after a reboot
# unless the Docker daemon itself is enabled at boot (see the README).
docker run -d --name omarchy-wuzapi --network omarchy-wa \
  --restart unless-stopped \
  -p 127.0.0.1:8080:8080 \
  -e WUZAPI_ADMIN_TOKEN="$WUZAPI_ADMIN_TOKEN" \
  -e WUZAPI_GLOBAL_ENCRYPTION_KEY="$WUZAPI_GLOBAL_ENCRYPTION_KEY" \
  -e WEBHOOK_FORMAT=json \
  -e TZ="${TZ:-America/Santiago}" \
  -e LOG_LEVEL=warn \
  -v "$STATE/wuzdata:/app/dbdata" \
  omarchy-wuzapi >/dev/null

# Run as the invoking user, not root: /state and /wuzdata are bind mounts
# of the host directories created above (owned by the invoking user), and
# a root sink writing into them is what produced files the host user could
# not read in the first place. python:3.12-alpine has no /etc/passwd entry
# for an arbitrary uid, so it has no home directory ($HOME comes back as
# "/" and Path.home() does not raise — sink/store.py never reaches it
# anyway, since WA_DATA_DIR and WA_SECRETS_FILE are always set below) and
# no username (`id` shows the uid, `whoami` fails) — neither is used by
# anything under sink/.
docker run -d --name omarchy-wa-sink --network omarchy-wa \
  --restart unless-stopped \
  --user "$(id -u):$(id -g)" \
  -e WA_DATA_DIR=/state \
  -e WA_WUZAPI_DB=/wuzdata/users.db \
  -v "$DATA:/state" \
  -v "$STATE/wuzdata:/wuzdata" \
  omarchy-wa-sink >/dev/null

echo "up. wuzapi on 127.0.0.1:8080 (loopback only), sink on the private network."
echo "Pair with:  wa-pair <number>"

# Self-heal: wuzapi's event-delivery path reads an in-memory webhook record
# that gets rebuilt (and the webhook lost) whenever a session logs in. If a
# session is already paired from a prior run, that in-memory record is gone
# on every container restart even though GET /webhook (DB-backed) still
# shows it set. Re-assert it now so an existing install doesn't have to be
# re-paired to keep receiving messages. Do nothing if no session is logged
# in yet (there's nothing to heal, and pairing will set it after login).
API=http://127.0.0.1:8080
WEBHOOK_URL="http://omarchy-wa-sink:8099"
WA_TOKEN="${WA_TOKEN:-}"
if [[ -n "$WA_TOKEN" ]]; then
  READY=""
  for _ in $(seq 1 20); do
    if curl -s --max-time 2 "$API/session/status" -H "token: $WA_TOKEN" >/dev/null 2>&1; then
      READY=1
      break
    fi
    sleep 1
  done
  if [[ -n "$READY" ]]; then
    STATUS=$(curl -s --max-time 3 "$API/session/status" -H "token: $WA_TOKEN" 2>/dev/null || true)
    LOGGED_IN=$(echo "$STATUS" | python3 -c "
import json,sys
try: print('true' if json.load(sys.stdin)['data']['loggedIn'] else 'false')
except Exception: print('false')
" 2>/dev/null || echo false)
    if [[ "$LOGGED_IN" == "true" ]]; then
      curl -s -X POST "$API/webhook" -H "token: $WA_TOKEN" \
        -H "Content-Type: application/json" \
        -d "{\"webhookurl\":\"$WEBHOOK_URL\",\"events\":[\"Message\"]}" >/dev/null
      GOT=$(curl -s "$API/webhook" -H "token: $WA_TOKEN" \
        | python3 -c "import json,sys; print(json.load(sys.stdin)['data']['webhook'])" 2>/dev/null || echo "")
      if [[ "$GOT" == "$WEBHOOK_URL" ]]; then
        echo "webhook re-asserted for already-logged-in session: $WEBHOOK_URL"
      else
        echo "warning: could not confirm webhook after re-asserting it on startup." >&2
        echo "  GET /webhook shows: ${GOT:-<unreadable>}" >&2
        echo "  expected: $WEBHOOK_URL" >&2
        echo "  Messages may NOT be delivered. Check with:" >&2
        echo "    curl -s $API/webhook -H 'token: \$WA_TOKEN'" >&2
      fi
    fi
  else
    echo "warning: wuzapi did not respond in time; skipped webhook self-heal check." >&2
  fi
fi
