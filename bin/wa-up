#!/usr/bin/env bash
# bin/wa-up — bring the bridge and the sink up.
# wuzapi is published on loopback only; the sink publishes nothing.
#
# Layout (see sink/store.py for the same comment):
#   $STATE/              0700, host only
#     secrets.env        0600 — NEVER mounted into a container
#     state/             queue.json, ctx/, config.json -> mounted at /state
#     wuzdata/           wuzapi's SQLite          -> mounted at /wuzdata
# The sink is the internet-facing side. It must not be handed the API token
# as well as the network route; keeping secrets.env out of its mounts makes
# that boundary structural rather than a property of the sink's imports.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE="${WA_STATE_ROOT:-$HOME/.local/share/omarchy-wa}"
SECRETS="${WA_SECRETS_FILE:-$STATE/secrets.env}"
DATA="${WA_DATA_DIR:-$STATE/state}"
mkdir -p "$DATA/ctx" "$STATE/wuzdata"
chmod 700 "$STATE" "$DATA"

# The sink used to run as root (uid 0) inside the container. Its bind
# mounts are the invoking user's directories, so everything it wrote —
# queue.json, ctx/*.json, config.json — landed root-owned. `tempfile.
# mkstemp` also makes new files mode 0600, so the invoking user (uid 1000)
# could not even read them: `wa-reply list` printed `[]`, `wa-status` said
# `pending: 0`, and the widget stayed hidden, all while the sink was
# working correctly. The sink now runs as the invoking user (see the
# `docker run --user` below), but an existing install may still have
# root-owned files left over from before this fix. Detect and repair those
# now, before anything is (re)started, instead of silently leaving a
# broken install running.
mapfile -t UNREADABLE < <(find "$DATA" "$STATE/wuzdata" -type f \
  \( ! -readable -o ! -writable \) 2>/dev/null)
if [[ ${#UNREADABLE[@]} -gt 0 ]]; then
  echo "found ${#UNREADABLE[@]} state file(s) not readable/writable by " \
       "$(id -u):$(id -g) — likely root-owned from a sink that ran as root " \
       "before this fix. Repairing..." >&2
  if docker run --rm -v "$DATA:/state" -v "$STATE/wuzdata:/wuzdata" \
       python:3.12-alpine chown -R "$(id -u):$(id -g)" /state /wuzdata \
       >/dev/null 2>&1; then
    echo "repaired ownership of $DATA and $STATE/wuzdata" >&2
  else
    echo "could not repair automatically. Run this yourself, then re-run wa-up:" >&2
    echo "  docker run --rm -v \"$DATA:/state\" -v \"$STATE/wuzdata:/wuzdata\" \\" >&2
    echo "    python:3.12-alpine chown -R \$(id -u):\$(id -g) /state /wuzdata" >&2
    exit 1
  fi
fi

# Migrate the pre-split layout, where the sink-visible files sat next to
# secrets.env at the state root.
for f in queue.json config.json; do
  if [[ -f "$STATE/$f" && ! -e "$DATA/$f" ]]; then
    mv "$STATE/$f" "$DATA/$f"
    echo "moved $f into $DATA/"
  fi
done
if [[ -d "$STATE/ctx" && "$STATE/ctx" != "$DATA/ctx" ]]; then
  if compgen -G "$STATE/ctx/*.json" >/dev/null; then
    mv "$STATE"/ctx/*.json "$DATA/ctx/"
    echo "moved per-chat context into $DATA/ctx/"
  fi
  rmdir "$STATE/ctx" 2>/dev/null || true
fi

# quick_replies is no longer seeded here: it lives per account since the
# multi-account migration (state/accounts.json), and seeding a canned
# default into config.json's now-vestigial top-level key would collide
# with that move — on a real install, migrate_single_account() moves the
# user's own quick_replies onto the "personal" account, and this block
# would immediately overwrite config.json with the factory default again,
# which bin/wa-reply's `quick` command (still reading config.json until
# Task 3) would then show instead of what the user configured. Seeding now
# belongs to wa-pair, per account.

if [[ ! -f "$SECRETS" ]]; then
  mkdir -p "$(dirname "$SECRETS")"
  {
    echo "WUZAPI_ADMIN_TOKEN=$(openssl rand -hex 16)"
    echo "WUZAPI_GLOBAL_ENCRYPTION_KEY=$(openssl rand -hex 16)"
    echo "WA_TOKEN=$(openssl rand -hex 12)"
  } > "$SECRETS"
  chmod 600 "$SECRETS"
fi
# shellcheck disable=SC1090
source "$SECRETS"

docker network create omarchy-wa >/dev/null 2>&1 || true

# Rebuild the sink image on EVERY run, unconditionally. This used to be
# guarded by `docker image inspect`, which meant an install whose image
# predated a code change kept running that old image forever: `wa-up`
# would migrate the state to the new layout and then start a sink that
# knew nothing about it — writing bare `<jid>` ids with no `account`
# field (which `wa-reply` then refuses) into a queue the migration had
# just rewritten, and flat `ctx/<jid>.json` files nothing reads. Both
# READMEs promise that upgrading needs nothing by hand beyond `wa-up`,
# so `wa-up` is what has to make that true.
#
# Chosen over a staleness check (image-vs-source timestamps, a content
# hash baked in as a label, probing the image for `sink/accounts.py`)
# deliberately: a staleness check is only as correct as its idea of what
# "new enough" means, and every way it can be wrong ends with the stale
# sink running against migrated state — corrupting a real person's queue
# silently. An unconditional build cannot be wrong; it costs a few
# seconds, and near-zero when nothing changed, since Docker's layer cache
# does the work. Correctness here is worth strictly more than the
# seconds. It also means the running sink can never be older than the
# code, which is the invariant, not merely "usually up to date".
docker build -t omarchy-wa-sink -f "$ROOT/docker/sink.Dockerfile" "$ROOT"

if ! docker image inspect omarchy-wuzapi >/dev/null 2>&1; then
  echo "Missing image omarchy-wuzapi. Build it from asternic/wuzapi:" >&2
  echo "  git clone --depth 1 https://github.com/asternic/wuzapi /tmp/wuzapi" >&2
  echo "  docker build -t omarchy-wuzapi /tmp/wuzapi" >&2
  exit 1
fi

# ORDERING, LOAD-BEARING — do not move the migration below this line, and
# do not move this `docker rm -f` below the migration.
#
# The sink must be STOPPED before the state is migrated. While the old
# sink is alive it is still receiving real messages and writing them in
# the OLD shape. An event that lands after migrate_single_account() has
# rewritten queue.json and ctx/ is then permanently unmigrated: the
# migration is gated on accounts.json, which now exists, so it never
# runs again and that message keeps a bare `<jid>` id with no `account`
# field for good — a conversation `wa-reply` refuses to answer. The
# window is only a few seconds wide, but the box is receiving a real
# person's mail, so a few seconds is enough.
#
# Both images are built ABOVE this line on purpose too: a build failure
# must leave the existing stack running rather than take it down first
# and then discover it cannot bring it back.
docker rm -f omarchy-wuzapi omarchy-wa-sink >/dev/null 2>&1 || true

# Migrate a pre-multi-account install to accounts.json. Runs with nothing
# running (see the ordering note above) and before anything is started:
# the sink and every account-aware script (wa-reply, wa-status, wa-heal)
# assume accounts.json exists. Idempotent (store.migrate_single_account's
# own gate: a no-op once accounts.json exists), and safe to run on a
# brand-new install too — it then seeds the "personal" account other
# scripts already expect. Runs AFTER secrets.env exists so its own
# WA_TOKEN -> WA_TOKEN_PERSONAL copy (spec step 2) has a source token to
# copy on a fresh install, not just a real migration.
MIGRATE_MSG=$(python3 -c '
import sys
sys.path.insert(0, sys.argv[1])
from sink import store
changed = store.migrate_single_account(sys.argv[2])
print("migrated to accounts.json" if changed else "accounts.json already present")
' "$ROOT" "$STATE") || {
  echo "error: migration to accounts.json failed. Not starting anything." >&2
  exit 1
}
echo "$MIGRATE_MSG"
# Migration may have just appended WA_TOKEN_PERSONAL to secrets.env;
# re-source so it is in this shell's environment too.
# shellcheck disable=SC1090
source "$SECRETS"

# --restart unless-stopped: bring both containers back after a crash or a
# host reboot without needing wa-up run by hand. Not `always` — this stack
# holds a live link to the person's personal WhatsApp session, so a
# deliberate `docker stop` must stay stopped, not resurrect itself on the
# next boot. This alone does not bring the stack back after a reboot
# unless the Docker daemon itself is enabled at boot (see the README).
docker run -d --name omarchy-wuzapi --network omarchy-wa \
  --restart unless-stopped \
  -p 127.0.0.1:8080:8080 \
  -e WUZAPI_ADMIN_TOKEN="$WUZAPI_ADMIN_TOKEN" \
  -e WUZAPI_GLOBAL_ENCRYPTION_KEY="$WUZAPI_GLOBAL_ENCRYPTION_KEY" \
  -e WEBHOOK_FORMAT=json \
  -e TZ="${TZ:-America/Santiago}" \
  -e LOG_LEVEL=warn \
  -v "$STATE/wuzdata:/app/dbdata" \
  omarchy-wuzapi >/dev/null

# Run as the invoking user, not root: /state and /wuzdata are bind mounts
# of the host directories created above (owned by the invoking user), and
# a root sink writing into them is what produced files the host user could
# not read in the first place. python:3.12-alpine has no /etc/passwd entry
# for an arbitrary uid, so it has no home directory ($HOME comes back as
# "/" and Path.home() does not raise — sink/store.py never reaches it
# anyway, since WA_DATA_DIR and WA_SECRETS_FILE are always set below) and
# no username (`id` shows the uid, `whoami` fails) — neither is used by
# anything under sink/.
docker run -d --name omarchy-wa-sink --network omarchy-wa \
  --restart unless-stopped \
  --user "$(id -u):$(id -g)" \
  -e WA_DATA_DIR=/state \
  -e WA_WUZAPI_DB=/wuzdata/users.db \
  -v "$DATA:/state" \
  -v "$STATE/wuzdata:/wuzdata" \
  omarchy-wa-sink >/dev/null

echo "up. wuzapi on 127.0.0.1:8080 (loopback only), sink on the private network."
echo "Pair with:  wa-pair <account-id> <number>"

# Self-heal: wuzapi's event-delivery path reads an in-memory webhook record
# that gets rebuilt (and the webhook lost) whenever a session logs in. If a
# session is already paired from a prior run, that in-memory record is gone
# on every container restart even though GET /webhook (DB-backed) still
# shows it set. The actual re-assert-and-verify logic lives in bin/wa-heal,
# a single implementation that this script and the systemd --user timer
# installed by install.sh both call — so the periodic timer (and a run at
# login) keep healing this automatically after a crash, a `docker restart`,
# or a reboot, without a second copy of the logic that could drift from
# this one. Here we just wait for wuzapi to answer first, so the very first
# run after `wa-up` gives an immediate, useful answer instead of the "not
# reachable yet" a bare timer tick would print moments after a fresh start.
#
# Answering is not enough, though: a previously-paired device's credentials
# survive the container recreate above, but wuzapi still has to reconnect
# to WhatsApp's servers from scratch, and /session/status answers
# immediately while reporting loggedIn:false until that reconnect finishes
# — a race, not a hang. wa-heal (correctly, since it must stay fast and
# idempotent for the timer) treats loggedIn:false as "nothing to heal", so
# calling it the instant wuzapi answers can skip the one re-assert that
# matters and leave the stack silently deaf — containers up, wa-status
# healthy — until the next timer tick, dropping every message in between.
# wa-up caused this restart, so wa-up is the one that waits for the
# reconnect, not wa-heal.
#
# "Never paired" and "paired but mid-reconnect" must be told apart PER
# ACCOUNT, since each has its own token and its own independent reconnect
# race with WhatsApp's servers — one account still reconnecting must not
# stop another, already-reconnected account from being healed promptly.
#
# This used to be decided up front, for the whole stack, from whether
# $STATE/.paired existed — a marker file `wa-pair` touched the first time
# any account ever logged in. That is a claim ABOUT reality, not reality:
# an install paired before the marker existed has none, even though
# wuzapi has held a real session the whole time, and `wa-up` then read the
# absence as "nothing to heal" and said so — while `wa-status` reported
# the same account as logged in seconds later. The marker also never
# earned a place as a fast path: telling the two cases apart already
# costs one GET /session/status call per account, the same call the wait
# loop below needs anyway, so reading a local file first saved nothing.
# It is dropped rather than kept as a "hint" that can go stale.
#
# Real state instead: wuzapi persists the account's JID in its own SQLite
# the first time a login ever succeeds (see wuzapi's GetStatus handler —
# it writes `UPDATE users SET jid=...` off the live client the moment it
# observes IsLoggedIn(), and `wa-pair`'s own login-poll loop is what makes
# that first write happen). `GET /session/status` keeps echoing that
# persisted `jid` back even while `loggedIn` is transiently false during
# a post-restart reconnect, because the DB row survives the restart. So:
#   - `jid` empty      -> this account has never completed a login, ever.
#                         Calm: nothing to wait for.
#   - `jid` non-empty  -> a login happened at some point; `loggedIn:false`
#                         right now is the reconnect race, not the truth.
#                         Worth a bounded wait, loud if it doesn't land.
#   - the token itself is unrecognized by wuzapi (401, no `data` at all)
#     -> wuzapi has no user under this token, so there is nothing paired
#        to find, same as `jid` empty. This is the normal shape of a
#        fresh install: the migration above copies WA_TOKEN into
#        WA_TOKEN_PERSONAL before `wa-pair` has ever created that wuzapi
#        user, so the token exists in secrets.env with nothing behind it
#        yet.
#   - the read itself failed (curl error, unparsable body) even though
#     the bare reachability probe below succeeded -> genuinely ambiguous.
#     Treated as "assume paired, wait" on purpose: skipping the wait on a
#     wrongly-guessed "never paired" silently drops a real account's
#     messages, where waiting 30s on a wrongly-guessed "paired" costs
#     nothing but a calm message anyway.
API=http://127.0.0.1:8080
READY=""
for _ in $(seq 1 20); do
  if curl -s --max-time 2 "$API/session/status" >/dev/null 2>&1; then
    READY=1
    break
  fi
  sleep 1
done

if [[ -z "$READY" ]]; then
  echo "warning: wuzapi did not respond in time; skipped webhook self-heal check." >&2
else
  # Every configured account. accounts.json is guaranteed to exist by now
  # (the migration above ran unconditionally before this point); a broken
  # accounts.json here falls through to ACCOUNT_LIST being empty, and
  # bin/wa-heal (called below with no argument) is what actually reports
  # that loudly — this loop does not duplicate that diagnostic.
  ACCOUNT_LIST=$(python3 -c '
import sys
sys.path.insert(0, sys.argv[1])
from sink import accounts, store
try:
    for a in accounts.load(sys.argv[2]):
        aid = a.get("id")
        if aid:
            print(aid)
except store.StoreReadError:
    pass
' "$ROOT" "$DATA")

  if [[ -z "$ACCOUNT_LIST" ]]; then
    echo "warning: no readable accounts found to heal; asking wa-heal to explain why:" >&2
    WA_STATE_ROOT="$STATE" WA_DATA_DIR="$DATA" WA_SECRETS_FILE="$SECRETS" WA_API="$API" "$ROOT/bin/wa-heal" || true
  else
    while IFS= read -r account_id; do
      [[ -z "$account_id" ]] && continue
      # The token variable's name has exactly one derivation — reached
      # through `wa-reply token-var`, never re-derived here. An id
      # straight from accounts.load() is already validated.
      token_var=$("$ROOT/bin/wa-reply" token-var "$account_id") || continue
      token="${!token_var:-}"
      if [[ -z "$token" ]]; then
        echo "wa-up: $account_id: not paired yet — nothing to wait for."
        continue
      fi

      # Real-state probe: has this account EVER completed a login, per
      # wuzapi's own persisted `jid` (see the block comment above this
      # section for why this replaces the old marker-file check).
      PROBE=$(curl -s --max-time 2 "$API/session/status" -H "token: $token" 2>/dev/null || true)
      EVER_PAIRED=$(echo "$PROBE" | python3 -c "
import json, sys
raw = sys.stdin.read()
try:
    parsed = json.loads(raw)
except Exception:
    print('unknown')  # read failed even though wuzapi is reachable overall
    sys.exit()
data = parsed.get('data')
if not isinstance(data, dict):
    print('never')    # e.g. 401 for a token wuzapi has no user under
    sys.exit()
print('paired' if data.get('jid') else 'never')
" 2>/dev/null || echo unknown)

      if [[ "$EVER_PAIRED" == "never" ]]; then
        echo "wa-up: $account_id: not paired yet — nothing to wait for."
        continue
      elif [[ "$EVER_PAIRED" == "unknown" ]]; then
        echo "wa-up: $account_id: could not confirm pairing state from wuzapi;" >&2
        echo "  assuming paired and waiting, to be safe." >&2
      fi

      # Bound chosen from what reconnecting a paired session actually
      # takes (a few seconds, per wa-pair's own observed handshake) with
      # generous headroom for a slow network — 30s, well short of the
      # 5-minute timer interval, so a genuinely stuck reconnect is
      # reported promptly instead of wa-up hanging on one account while
      # another, already-reconnected account waits behind it.
      LOGGED_IN=""
      for _ in $(seq 1 30); do
        STATUS=$(curl -s --max-time 2 "$API/session/status" -H "token: $token" 2>/dev/null || true)
        if echo "$STATUS" | python3 -c "
import json, sys
try:
    sys.exit(0 if json.load(sys.stdin)['data']['loggedIn'] else 1)
except Exception:
    sys.exit(1)
" 2>/dev/null; then
          LOGGED_IN=1
          break
        fi
        sleep 1
      done
      if [[ -n "$LOGGED_IN" ]]; then
        WA_STATE_ROOT="$STATE" WA_DATA_DIR="$DATA" WA_SECRETS_FILE="$SECRETS" WA_API="$API" \
          "$ROOT/bin/wa-heal" "$account_id" || true
      else
        echo "warning: $account_id did not log back in within 30s — the webhook" >&2
        echo "  could NOT be re-asserted for this account. Incoming messages will" >&2
        echo "  be DROPPED until it is. The wa-heal timer will retry within 5" >&2
        echo "  minutes, or run it now: bin/wa-heal $account_id" >&2
      fi
    done <<<"$ACCOUNT_LIST"
  fi
fi
