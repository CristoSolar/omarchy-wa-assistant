#!/usr/bin/env bash
# bin/wa-pair — link a WhatsApp account by 8-digit code.
# Pairing makes WhatsApp dump the account history into wuzapi's SQLite;
# days_to_sync_history cannot prevent it, so we purge right afterwards.
set -euo pipefail

NUMBER="${1:?usage: wa-pair <number, international, no +>}"
STATE="${WA_DATA_DIR:-$HOME/.local/share/omarchy-wa}"
source "$STATE/secrets.env"
API=http://127.0.0.1:8080
DB="$STATE/wuzdata/users.db"

# Create user; "already exists" is not an error
RESP=$(curl -s -w "\n%{http_code}" -X POST "$API/admin/users" \
  -H "Authorization: $WUZAPI_ADMIN_TOKEN" \
  -H "Content-Type: application/json" \
  -d "{\"name\":\"omarchy\",\"token\":\"$WA_TOKEN\",\"events\":\"Message\"}")
HTTP_CODE=$(echo "$RESP" | tail -1)
BODY=$(echo "$RESP" | sed '$d')
if [[ "$HTTP_CODE" != "200" && ! "$BODY" =~ "already" ]]; then
  echo "error: failed to create wuzapi user (HTTP $HTTP_CODE): $BODY" >&2
  exit 1
fi

curl -s -X POST "$API/session/connect" -H "token: $WA_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"Subscribe":["Message"],"Immediate":true}' >/dev/null
sleep 3

curl -s -X POST "$API/webhook" -H "token: $WA_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"webhookurl":"http://omarchy-wa-sink:8099","events":["Message"]}' >/dev/null

CODE=$(curl -s -X POST "$API/session/pairphone" -H "token: $WA_TOKEN" \
  -H "Content-Type: application/json" -d "{\"Phone\":\"$NUMBER\"}" \
  | python3 -c "import json,sys; print(json.load(sys.stdin)['data']['LinkingCode'])")

echo "Linking code: $CODE"
echo "WhatsApp > Linked devices > Link device > Link with phone number"

for _ in $(seq 1 40); do
  if curl -s "$API/session/status" -H "token: $WA_TOKEN" \
     | grep -q '"loggedIn":true'; then
    echo "linked."
    echo "waiting for WhatsApp to finish sending history..."

    # Wait for history sync to stabilize before purging
    WAIT_RESULT=$(python3 -c "
import sys
sys.path.insert(0, '$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)')
from sink.purge import wait_until_stable
count, settled = wait_until_stable('$DB')
print(f'{count},{settled}')
")
    PRE_PURGE=$(echo "$WAIT_RESULT" | cut -d, -f1)
    SETTLED=$(echo "$WAIT_RESULT" | cut -d, -f2)

    docker restart omarchy-wa-sink >/dev/null
    sleep 1

    # Check what actually got purged
    POST_PURGE=$(python3 -c "
import sys
sys.path.insert(0, '$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)')
from sink.purge import count_history
print(count_history('$DB'))
")

    if [[ "$SETTLED" == "True" ]] && [[ "$POST_PURGE" == "0" ]]; then
      echo "history purged: $PRE_PURGE rows deleted, table now empty."
      exit 0
    else
      echo "WARNING: history may NOT have been fully cleared." >&2
      echo "  History was still arriving when purge ran: settled=$SETTLED" >&2
      echo "  Rows before restart: $PRE_PURGE, rows remaining: $POST_PURGE" >&2
      echo "  Please run 'docker restart omarchy-wa-sink' in a minute and check again." >&2
      exit 1
    fi
  fi
  sleep 5
done
echo "timed out waiting for the link" >&2
exit 1
