#!/usr/bin/env bash
# bin/wa-pair — link a WhatsApp account by 8-digit code.
# Pairing makes WhatsApp dump the account history into wuzapi's SQLite;
# days_to_sync_history cannot prevent it, so we purge right afterwards.
set -euo pipefail

NUMBER="${1:?usage: wa-pair <number, international, no +>}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE="${WA_STATE_ROOT:-$HOME/.local/share/omarchy-wa}"
SECRETS="${WA_SECRETS_FILE:-$STATE/secrets.env}"
# shellcheck disable=SC1090
source "$SECRETS"
API=http://127.0.0.1:8080
DB="$STATE/wuzdata/users.db"

wait_for_history() {
  # Prints "<count> <settled> <saw_rows>".
  python3 -c '
import sys
sys.path.insert(0, sys.argv[1])
from sink.purge import wait_until_stable
count, settled, saw_rows = wait_until_stable(sys.argv[2])
print(count, settled, saw_rows)
' "$ROOT" "$DB"
}

count_history() {
  python3 -c '
import sys
sys.path.insert(0, sys.argv[1])
from sink.purge import count_history
print(count_history(sys.argv[2]))
' "$ROOT" "$DB"
}

# Create user; "already exists" is not an error
RESP=$(curl -s -w "\n%{http_code}" -X POST "$API/admin/users" \
  -H "Authorization: $WUZAPI_ADMIN_TOKEN" \
  -H "Content-Type: application/json" \
  -d "{\"name\":\"omarchy\",\"token\":\"$WA_TOKEN\",\"events\":\"Message\"}")
HTTP_CODE=$(echo "$RESP" | tail -1)
BODY=$(echo "$RESP" | sed '$d')
if [[ "$HTTP_CODE" != "200" && ! "$BODY" =~ "already" ]]; then
  echo "error: failed to create wuzapi user (HTTP $HTTP_CODE): $BODY" >&2
  exit 1
fi

curl -s -X POST "$API/session/connect" -H "token: $WA_TOKEN" \
  -H "Content-Type: application/json" \
  -d '{"Subscribe":["Message"],"Immediate":true}' >/dev/null
sleep 3

WEBHOOK_URL="http://omarchy-wa-sink:8099"

set_webhook() {
  curl -s -X POST "$API/webhook" -H "token: $WA_TOKEN" \
    -H "Content-Type: application/json" \
    -d "{\"webhookurl\":\"$WEBHOOK_URL\",\"events\":[\"Message\"]}" >/dev/null
}

verify_webhook() {
  # wuzapi keeps a separate in-memory copy of the webhook that is rebuilt
  # when a session logs in, discarding whatever was set before login. GET
  # /webhook reads the durable (DB-backed) copy, which is necessary but not
  # sufficient: only a webhook set AFTER login is guaranteed to also be in
  # the in-memory record that actually delivers events. Never assume a POST
  # stuck; always read it back.
  GOT=$(curl -s "$API/webhook" -H "token: $WA_TOKEN" \
    | python3 -c "import json,sys; print(json.load(sys.stdin)['data']['webhook'])" 2>/dev/null)
  [[ "$GOT" == "$WEBHOOK_URL" ]]
}

# Best-effort pre-pairing attempt; harmless but NOT authoritative — see the
# post-login set_webhook call below, which is the one that actually sticks.
set_webhook

CODE=$(curl -s -X POST "$API/session/pairphone" -H "token: $WA_TOKEN" \
  -H "Content-Type: application/json" -d "{\"Phone\":\"$NUMBER\"}" \
  | python3 -c "import json,sys; print(json.load(sys.stdin)['data']['LinkingCode'])")

echo "Linking code: $CODE"
echo "WhatsApp > Linked devices > Link device > Link with phone number"

for _ in $(seq 1 40); do
  if curl -s "$API/session/status" -H "token: $WA_TOKEN" \
     | grep -q '"loggedIn":true'; then
    echo "linked."

    # Marks this install as having reached loggedIn:true at least once, so
    # `wa-up` can tell "never paired" (nothing to wait for or heal) apart
    # from "paired, mid-reconnect after a restart" (worth a bounded wait)
    # the next time it recreates the containers. Idempotent; safe to
    # re-touch on every successful pairing.
    touch "$STATE/.paired" 2>/dev/null || true

    # AUTHORITATIVE webhook set. wuzapi's session login rebuilds its
    # in-memory client record, wiping any webhook set before login even
    # though the DB row (and GET /webhook) still shows it. A webhook set
    # only before login never delivers a single message — silently. Set it
    # again now, then read it back; do not just assume the POST worked.
    set_webhook
    if ! verify_webhook; then
      echo "error: webhook did not stick after login. GET /webhook shows:" >&2
      echo "  ${GOT:-<unreadable>}" >&2
      echo "  expected: $WEBHOOK_URL" >&2
      echo "  Messages will NOT be delivered until this is fixed. Try:" >&2
      echo "    curl -s -X POST $API/webhook -H 'token: \$WA_TOKEN' \\" >&2
      echo "      -H 'Content-Type: application/json' \\" >&2
      echo "      -d '{\"webhookurl\":\"$WEBHOOK_URL\",\"events\":[\"Message\"]}'" >&2
      echo "  then confirm with: curl -s $API/webhook -H 'token: \$WA_TOKEN'" >&2
      exit 1
    fi
    echo "webhook confirmed: $WEBHOOK_URL"

    echo "waiting for WhatsApp to finish sending history..."

    # loggedIn flips at the END of the pairing handshake, before whatsmeow
    # starts streaming history-sync blobs. Wait for rows to appear and then
    # stop growing; saw_rows tells us whether any ever appeared at all.
    # `read < <(...)` reports the READ's status, not the subshell's, so a
    # crashing wait_for_history would leave these empty and fall into the
    # "no rows were ever observed" branch — reporting a crash to the user
    # as uncertainty, with exit 0. Capture first, check, then split.
    if ! WAIT_OUT=$(wait_for_history); then
      echo "error: could not read wuzapi's history table while waiting for the" >&2
      echo "  history dump. NOTHING was purged and nothing was verified." >&2
      echo "  Check 'docker logs omarchy-wa-sink' and the database at:" >&2
      echo "    $DB" >&2
      exit 1
    fi
    read -r PRE_PURGE SETTLED SAW_ROWS <<<"$WAIT_OUT"
    if [[ -z "${SAW_ROWS:-}" ]]; then
      echo "error: unexpected output from the history wait: ${WAIT_OUT@Q}" >&2
      exit 1
    fi

    docker restart omarchy-wa-sink >/dev/null

    # The sink purges on startup. Container start + Python + deleting ~15k
    # rows + VACUUM does not fit in a fixed one-second sleep, and a sleep
    # that is too short fires the warning on the happy path — which trains
    # the user to ignore the one warning that protects their history. Poll
    # instead, with a bound.
    if ! POST_PURGE=$(count_history); then
      echo "error: could not re-count wuzapi's history table after the purge." >&2
      exit 1
    fi
    for _ in $(seq 1 45); do
      [[ "$POST_PURGE" == "0" ]] && break
      sleep 2
      POST_PURGE=$(count_history) || POST_PURGE=""
    done
    if [[ -z "$POST_PURGE" ]]; then
      echo "error: could not re-count wuzapi's history table after the purge." >&2
      exit 1
    fi

    if [[ "$SAW_ROWS" != "True" ]]; then
      # Honest uncertainty. We cannot tell "this account has no history"
      # from "the dump has not started" by looking at the database, so we
      # do not claim either. This is NOT a success message.
      echo "history: no rows were ever observed in wuzapi's message_history table."
      echo "  That may mean this account has no history to sync, or it may mean"
      echo "  WhatsApp had not started sending it yet. This run cannot tell which."
      echo "  Nothing was confirmed purged, because nothing was ever seen."
      echo "  If you want certainty, wait a few minutes and then run:"
      echo "    docker restart omarchy-wa-sink"
      echo "    docker logs omarchy-wa-sink   # look for the 'purged N history rows' line"
      exit 0
    fi

    if [[ "$SETTLED" == "True" && "$POST_PURGE" == "0" ]]; then
      echo "history purged: $PRE_PURGE rows deleted, table now empty."
      exit 0
    fi

    echo "WARNING: history may NOT have been fully cleared." >&2
    echo "  History was still arriving when purge ran: settled=$SETTLED" >&2
    echo "  Rows before restart: $PRE_PURGE, rows remaining: $POST_PURGE" >&2
    echo "  Please run 'docker restart omarchy-wa-sink' in a minute and check again." >&2
    exit 1
  fi
  sleep 5
done
echo "timed out waiting for the link" >&2
exit 1
