#!/usr/bin/env python3
# bin/wa-chat
"""Host-side CLI behind the chat window: list chats, page messages, mark read.

Always prints one JSON object on stdout and exits 0, so the QML caller can
show an error instead of losing it in a non-zero exit. It reads history
through sink/history.py and talks to wuzapi for exactly two things:
POST /chat/markread and GET /group/list, plus POST /user/check to
confirm a number before the owner starts a chat and POST /user/avatar for
profile pictures (downloaded from WhatsApp's own CDN). It never sends a message; only
bin/wa-reply does. A read here also takes the chat off the bar counter
(queue.json), by the sink's own rule for a read on the phone.

Usage: wa-chat chats | messages ACC JID [--before ID] | read ACC JID
              | contacts | resolve ACC PHONE | avatars ACC|TARGET... | members ACC GROUP
              | gifs [QUERY]  (Giphy, needs GIPHY_API_KEY in secrets.env)
"""
import json
import os
import sqlite3
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from sink import accounts as accounts_mod, contacts, history, readstate, store  # noqa: E402
from sink.server import _remove_unless_ambiguous  # noqa: E402

API = os.environ.get("WA_API", "http://127.0.0.1:8080")
GROUPS_TTL = 6 * 3600
RETRY_WINDOW = 50  # newest incoming rows re-acked per pending chat
AVATAR_TTL = 7 * 86400  # a picture, or "has none", is asked again after a week
AVATAR_GAP = 0.3  # seconds between asks: a burst of lookups looks like a bot
AVATAR_MAX = 512 * 1024
AVATAR_CDN = "https://pps.whatsapp.net/"


def _url(api, path):
    url = api + path
    if not url.startswith("http://127.0.0.1:"):
        raise ValueError(f"refusing a non-local wuzapi url: {url}")
    return url


def _token(acc_id):
    return _secret(accounts_mod.token_env_var(acc_id))


def _secret(var):
    if var in os.environ:
        return os.environ[var]
    try:
        lines = store.secrets_path().read_text().splitlines()
    except OSError:
        lines = []
    for line in lines:
        k, _, v = line.strip().partition("=")
        if k.strip() == var:
            return v.strip()
    raise OSError(f"no {var} in secrets.env")


def _request(method, acc_id, path, body=None):
    req = urllib.request.Request(
        _url(API, path), method=method, headers={"token": _token(acc_id), "Content-Type": "application/json"},
        data=json.dumps(body).encode() if body is not None else None)
    with urllib.request.urlopen(req, timeout=5) as r:
        return json.loads(r.read() or b"{}")


def http_post(acc_id, path, body):
    return _request("POST", acc_id, path, body)


def http_get(acc_id, path):
    return _request("GET", acc_id, path)


def _user_server(jid):
    """`user@server` without the device suffix. wuzapi's parseJID reads a
    value with no '@' as <user>@s.whatsapp.net, so a @lid sender must keep
    its server or the receipt targets the wrong participant."""
    user, _, server = jid.partition("@")
    return f"{user.split(':')[0]}@{server}"


def _account(d, acc_id):
    acc = accounts_mod.by_id(accounts_mod.load(d), acc_id)
    if acc is None:
        raise KeyError(f"unknown account {acc_id!r}")
    return acc


def _mark_read_on_wuzapi(post, acc_id, jid, pairs):
    """pairs: [(message_id, sender_jid)]. 1:1 chats send one call; groups one per sender."""
    if not pairs:
        return
    chat = jid
    if not jid.endswith("@g.us"):
        post(acc_id, "/chat/markread", {"Id": [m for m, _ in pairs], "ChatPhone": chat})
        return
    by_sender = {}
    for mid, sender in pairs:
        by_sender.setdefault(sender, []).append(mid)
    for sender, ids in by_sender.items():
        post(acc_id, "/chat/markread", {"Id": ids, "ChatPhone": chat, "SenderPhone": _user_server(sender)})


def read_chat(d, wuzdata, acc_id, jid, post):
    if not history.is_chat(jid):
        return {"ok": False, "error": f"{jid!r} no es un chat (estado, difusión o canal)"}
    acc = _account(d, acc_id)
    conn = history.connect(wuzdata)
    try:
        readstate.ensure(d, history.last_id(conn))
        uid = history.user_ids(conn)[acc["wuzapi_user"]]
        top = history.last_id(conn, uid, jid)
        pairs = history.unread_ids(conn, uid, jid, readstate.marker(readstate.load(d), acc_id, jid))
    finally:
        conn.close()
    try:
        _mark_read_on_wuzapi(post, acc_id, jid, pairs)
        ok = True
    except Exception:
        ok = False
    # ponytail: read.json is also written by the sink (in the container); mark()
    # is an atomic replace but load-modify-save, so two simultaneous writers can
    # lose one update. Accepted: the marker only rises and the next write fixes it.
    readstate.mark(d, acc_id, jid, top, pending=not ok)
    # The bar counts queue.json: the same rule as reading on the phone.
    _remove_unless_ambiguous(d, acc_id, jid)
    return {"ok": True} if ok else {"ok": False, "pending": True}


def _retry_pending(d, wuzdata, post):
    """True if wuzapi was unreachable (the first failure ends the pass).

    Acks only rows up to the top id the owner clicked: a message that
    arrived after the click was never seen. wuzapi answering 4xx is a
    definite no; retrying it forever would keep the window offline, so the
    pending read is dropped (the local marker already rose).
    """
    for key, top in list(readstate.load(d)["pending"].items()):
        acc_id, jid = store.split_entry_id(key)
        try:
            acc = _account(d, acc_id)
            conn = history.connect(wuzdata)
            try:
                uid = history.user_ids(conn)[acc["wuzapi_user"]]
                pairs = history.read_ids_upto(conn, uid, jid, top, RETRY_WINDOW)
            finally:
                conn.close()
        except (KeyError, ValueError, sqlite3.Error, history.SchemaError):
            continue  # stays pending; next list retries
        try:
            _mark_read_on_wuzapi(post, acc_id, jid, pairs)
        except urllib.error.HTTPError as exc:
            if not 400 <= exc.code < 500:
                return True
        except Exception:
            return True
        readstate.mark(d, acc_id, jid, 0, pending=False)
    return False


def _group_names(d, accounts, get):
    """(names, offline). A failed refresh backs off 60 s instead of retrying every poll."""
    path = Path(d) / "groups.json"
    cache = store.read_json(path, {})
    if not isinstance(cache, dict):
        cache = {}
    if time.time() - cache.get("fetched", 0) >= GROUPS_TTL:
        names = dict(cache.get("names", {}))
        offline = False
        try:
            for acc in accounts:
                data = get(acc["id"], "/group/list")
                groups = (data.get("data") or {}).get("Groups") or []
                names[acc["id"]] = {g["JID"]: g.get("Name", "") for g in groups}
            cache = {"fetched": time.time(), "names": names}
            store.atomic_write(path, json.dumps(cache))
        except Exception:
            offline = True  # keep what we have, retry in a minute
            cache = {"fetched": time.time() - GROUPS_TTL + 60, "names": names}
            store.atomic_write(path, json.dumps(cache))
        return names if offline else cache["names"], offline
    return cache.get("names", {}), False


def _text(msg):
    return msg["text"] or (f"[{msg['attachment']['type']}]" if msg.get("attachment") else "")


def _namer(wuzdata, instance):
    seen = {}

    def name_of(jid):
        if jid not in seen:
            seen[jid] = contacts.display_name(wuzdata, instance, jid, "")
        return seen[jid]
    return name_of


def list_chats(d, wuzdata, post, get=http_get):
    offline = _retry_pending(d, wuzdata, post)
    accts = accounts_mod.load(d)
    enabled = store.load_config(d).get("groups_enabled", [])
    names, names_offline = _group_names(d, accts, get)
    offline = offline or names_offline
    conn = history.connect(wuzdata)
    out = []
    try:
        readstate.ensure(d, history.last_id(conn))
        state = readstate.load(d)
        uids = history.user_ids(conn)
        for acc in accts:
            uid = uids.get(acc["wuzapi_user"])
            if uid is None:
                continue
            muted = contacts.muted_chats(wuzdata, acc["wuzapi_user"], time.time())
            pinned = contacts.pinned_chats(wuzdata, acc["wuzapi_user"])
            listed = set()
            for c in history.chats(conn, uid):
                jid, last = c["jid"], c["last"]
                group = jid.endswith("@g.us")
                name = (names.get(acc["id"], {}).get(jid) if group else None) or contacts.display_name(
                    wuzdata, acc["wuzapi_user"], jid, "" if last["from_me"] else last["push_name"])
                out.append({
                    "account": acc["id"], "label": acc.get("label", acc["id"]), "jid": jid, "name": name,
                    "last_text": contacts.with_mention_names(_text(last), last.get("mentions"),
                                                             _namer(wuzdata, acc["wuzapi_user"])), "last_ts": last["ts"], "last_id": c["last_id"],
                    "last_sender": "Tú" if last["from_me"] else contacts.display_name(
                        wuzdata, acc["wuzapi_user"], last["sender"], last["push_name"]),
                    "unread": history.unread_count(conn, uid, jid, readstate.marker(state, acc["id"], jid)),
                    "group": group, "muted": jid in muted and jid not in enabled, "pinned": jid in pinned})
                listed.add(jid)
            # pinned on the phone but nothing in history yet: still listed, like the phone does
            for jid in sorted(pinned - listed):
                group = jid.endswith("@g.us")
                name = (names.get(acc["id"], {}).get(jid) if group else None) or contacts.display_name(
                    wuzdata, acc["wuzapi_user"], jid, "")
                out.append({
                    "account": acc["id"], "label": acc.get("label", acc["id"]), "jid": jid, "name": name,
                    "last_text": "", "last_sender": "", "last_ts": "", "last_id": 0, "unread": 0,
                    "group": group, "muted": jid in muted and jid not in enabled, "pinned": True})
    finally:
        conn.close()
    out.sort(key=lambda c: (not c["pinned"], -c["last_id"]))
    return {"chats": out, "offline": offline}


def messages_page(d, wuzdata, acc_id, jid, before=None):
    acc = _account(d, acc_id)
    conn = history.connect(wuzdata)
    try:
        msgs, more = history.messages(conn, history.user_ids(conn)[acc["wuzapi_user"]], jid, before=before)
    finally:
        conn.close()
    seen, name_of = {}, _namer(wuzdata, acc["wuzapi_user"])
    # wuzapi keeps no datajson for a file sent through it; bin/wa-reply noted its name
    sent_names = store.read_json(Path(d) / "sent_files.json", {})
    for m in msgs:
        m["text"] = contacts.with_mention_names(m["text"], m.get("mentions"), name_of)
        a = m.get("attachment")
        if a and not a.get("name") and isinstance(sent_names, dict) and m["message_id"] in sent_names:
            a["name"] = str(sent_names[m["message_id"]])
        q = m.get("quote")
        if q:
            q["sender_name"] = "Tú" if q.get("from_me") else contacts.display_name(
                wuzdata, acc["wuzapi_user"], q["sender"], "") if q["sender"] else ""
        key = (m["sender"], m["push_name"])
        if m["from_me"]:
            m["sender_name"] = ""
        else:
            if key not in seen:
                seen[key] = contacts.display_name(wuzdata, acc["wuzapi_user"], m["sender"], m["push_name"])
            m["sender_name"] = seen[key]
    return {"messages": msgs, "more": more}


def list_contacts(d, wuzdata):
    return {"contacts": [dict(c, account=a["id"], label=a.get("label", a["id"]))
                         for a in accounts_mod.load(d)
                         for c in contacts.address_book(wuzdata, a["wuzapi_user"])]}


def resolve(d, wuzdata, acc_id, phone, post):
    """The chat jid WhatsApp gives a number (often an @lid, the same one an
    existing chat already uses), or an error if it is not on WhatsApp."""
    acc = _account(d, acc_id)
    digits = "".join(ch for ch in phone if ch.isdigit())
    if len(digits) < 8:
        return {"error": "número incompleto: con código de país, ej. +56912345678"}
    try:
        users = (post(acc_id, "/user/check", {"Phone": [digits]}).get("data") or {}).get("Users") or []
    except Exception:
        return {"error": "sin conexión con WhatsApp: no se pudo confirmar el número"}
    hit = next((u for u in users if u.get("IsInWhatsapp") and u.get("JID")), None)
    if hit is None:
        return {"error": f"+{digits} no está en WhatsApp"}
    jid = _user_server(hit["JID"])
    if not history.is_chat(jid) or jid.endswith("@g.us"):
        return {"error": f"WhatsApp devolvió algo que no es una persona: {jid}"}
    return {"jid": jid, "name": contacts.display_name(wuzdata, acc["wuzapi_user"], jid, "")}


def avatar_path(acc_id, target) -> Path:
    """Where a chat's (jid) or a contact's (phone) picture lives; the window
    builds the same path from avatar_root() + the same safe name."""
    accounts_mod.validate_id(acc_id)
    safe = "".join(ch for ch in target if ch.isalnum() or ch in "@.-_").lstrip(".")
    if not safe:
        raise ValueError(f"no usable avatar name in {target!r}")
    return store.state_root() / "avatars" / acc_id / f"{safe}.jpg"


def _download(url):
    if not url.startswith(AVATAR_CDN):
        raise ValueError(f"refusing an avatar url off WhatsApp's CDN: {url[:60]}")
    with urllib.request.urlopen(url, timeout=5) as r:
        data = r.read(AVATAR_MAX + 1)
    if len(data) > AVATAR_MAX:
        raise ValueError("avatar too large")
    return data


def avatars(keys, post, download=_download, sleep=time.sleep, now=time.time):
    """Fetch missing or week-old pictures for "acc|target" keys, one at a time.

    A target with no picture leaves an empty file, so it is not asked again
    for a week. The first network failure ends the pass (offline).
    "have" lists every key whose picture is on disk, so the window only
    loads files that exist and decode.
    """
    fetched, offline = _fetch_avatars(keys, post, download, sleep, now)
    have = []
    for key in keys:
        acc_id, _, target = key.partition("|")
        try:
            if avatar_path(acc_id, target).stat().st_size > 0:
                have.append(key)
        except (ValueError, OSError):
            pass
    return {"fetched": fetched, "have": have, "offline": offline}


def _fetch_avatars(keys, post, download, sleep, now):
    fetched, asked = [], False
    for key in keys:
        acc_id, _, target = key.partition("|")
        try:
            path = avatar_path(acc_id, target)
        except ValueError:
            continue
        try:
            if now() - path.stat().st_mtime < AVATAR_TTL:
                continue
        except OSError:
            pass
        if asked:
            sleep(AVATAR_GAP)
        asked = True
        try:
            url = (post(acc_id, "/user/avatar", {"Phone": target, "Preview": True}).get("data") or {}).get("url", "")
            data = download(url) if url else b""
        except urllib.error.HTTPError as exc:
            if exc.code != 500:  # wuzapi answers 500 for "has no profile picture"
                return fetched, True
            data = b""
        except Exception:
            return fetched, True
        for folder in (path.parent.parent, path.parent):  # contacts' faces: owner only
            folder.mkdir(mode=0o700, parents=True, exist_ok=True)
            os.chmod(folder, 0o700)
        tmp = path.with_suffix(".tmp")
        tmp.write_bytes(data)
        os.replace(tmp, path)
        if data:
            fetched.append(key)
    return fetched, False


def members(d, wuzdata, acc_id, group, get):
    """Who can be @mentioned in a group: [{jid, name}], the owner left out."""
    acc = _account(d, acc_id)
    if not group.endswith("@g.us") or not history.is_chat(group):
        return {"error": f"{group!r} no es un grupo"}
    try:
        data = get(acc_id, "/group/info?groupJID=" + urllib.parse.quote(group)).get("data") or {}
    except Exception:
        return {"error": "sin conexión con WhatsApp: no se pudo leer el grupo"}
    ours = contacts.our_ids(wuzdata, acc["wuzapi_user"])
    out = []
    for p in data.get("Participants") or []:
        jid, pn = _user_server(p.get("JID") or ""), _user_server(p.get("PhoneNumber") or "")
        if not history.is_chat(jid) or jid in ours or pn in ours:
            continue
        name = contacts.display_name(wuzdata, acc["wuzapi_user"], pn if history.is_chat(pn) else jid,
                                     p.get("DisplayName") or "")
        out.append({"jid": jid, "name": name})
    return {"members": sorted(out, key=lambda m: m["name"].casefold())}


GIPHY = "https://api.giphy.com/v1/gifs/"


def gif_search(query, get_json=None):
    """Giphy search (trending when empty). The query goes to Giphy, nothing else does."""
    try:
        key = _secret("GIPHY_API_KEY")
    except OSError:
        return {"error": "nokey", "secrets": str(store.secrets_path())}
    params = {"api_key": key, "limit": 30, "rating": "pg-13", "lang": "es"}
    if query.strip():
        params["q"] = query.strip()
    url = GIPHY + ("search" if query.strip() else "trending") + "?" + urllib.parse.urlencode(params)
    if get_json is None:
        def get_json(u):
            with urllib.request.urlopen(u, timeout=15) as r:
                return json.loads(r.read())
    out = []
    for g in get_json(url).get("data") or []:
        im = g.get("images") or {}
        preview = (im.get("fixed_width_small") or {}).get("url")
        mp4 = (im.get("original") or {}).get("mp4") or (im.get("fixed_width") or {}).get("mp4")
        if preview and mp4:
            out.append({"preview": preview, "mp4": mp4, "title": g.get("title") or ""})
    return {"gifs": out}


def run_cli(argv, d, wuzdata):
    try:
        cmd = argv[0]
        if cmd == "chats":
            return list_chats(d, wuzdata, http_post)
        if cmd == "messages":
            before = int(argv[argv.index("--before") + 1]) if "--before" in argv else None
            return messages_page(d, wuzdata, argv[1], argv[2], before)
        if cmd == "read":
            return read_chat(d, wuzdata, argv[1], argv[2], http_post)
        if cmd == "contacts":
            return list_contacts(d, wuzdata)
        if cmd == "resolve":
            return resolve(d, wuzdata, argv[1], argv[2], http_post)
        if cmd == "members":
            return members(d, wuzdata, argv[1], argv[2], http_get)
        if cmd == "avatars":
            return avatars(argv[1:], http_post)
        if cmd == "gifs":
            return gif_search(" ".join(argv[1:]))
        return {"error": f"comando desconocido: {cmd}"}
    except history.SchemaError:
        return {"error": "esquema"}
    except sqlite3.OperationalError as exc:
        return {"error": "ocupada" if "locked" in str(exc) else str(exc)}
    except (IndexError, ValueError):
        return {"error": "uso: wa-chat chats | messages ACC JID [--before ID] | read ACC JID"
                         " | contacts | resolve ACC PHONE"}
    except Exception as exc:  # the window shows whatever we say
        return {"error": f"{type(exc).__name__}: {exc}"}


if __name__ == "__main__":
    print(json.dumps(run_cli(sys.argv[1:], store.data_dir(), store.wuzdata_dir()), ensure_ascii=False))
