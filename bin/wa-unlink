#!/usr/bin/env bash
# bin/wa-unlink <account-id> — remove an account completely.
#
# Logs the session out of wuzapi, removes the account's entry from
# accounts.json, its token from secrets.env, its context ring under
# ctx/<id>/, and discards its queue entries. Other accounts are untouched.
#
# Queue entries are DISCARDED, not preserved: bin/wa-reply refuses any
# entry whose `account` is not in accounts.json (see UnknownAccount there),
# so once this account is gone those entries could never be answered and
# could never be cleared — visible, permanent, useless. Discarding them is
# the honest outcome. The caller is expected to show the count first (see
# --count-only below) and ask for a typed confirmation before running this
# for real.
#
# agents/<id>.md — the tone file — is deliberately LEFT BEHIND. It holds
# no credential, it is prose the person wrote and edited by hand, and
# re-linking the same id later should hand them their customisation back
# rather than make them write it again.
#
# --json is additive, exactly like bin/wa-pair's --json: one JSON object
# per line, human mode unchanged and still the default. See
# docs/superpowers/specs/2026-09-23-settings-ui-design.md.
#
# --count-only is a second, additive mode: it reports how many queue
# entries THIS invocation would discard, and changes nothing at all. The
# settings screen needs this number at the moment it asks for the typed
# confirmation, not one cached from when the screen opened (an entry can
# arrive at any time), so it must be askable on its own, separately from
# actually unlinking.
#
# --- Ordering: the hard part -----------------------------------------------
#
# This project has already lost data once to a migration step that ran
# twice and destroyed what an earlier partial run had created
# (sink/store.py's migrate_single_account carries the fix and the lesson).
# The order below is chosen so a crash between ANY two steps leaves a state
# a re-run converges from, never one it worsens:
#
#   1. Log out of wuzapi, using the account's token while it still exists.
#      This is the one step that is not local and not reversible by
#      re-running: once the token is gone, nothing can identify the
#      session to log it out later. It must run FIRST, while the
#      credential that authenticates it is still there. It is also the one
#      step this script cannot make idempotent by itself — wuzapi is
#      expected to treat logging out an already-logged-out session as a
#      no-op the way it treats other repeat calls, and a wuzapi that
#      cannot be reached must not block the rest: leaving a local account
#      permanently un-removable because a container is down is worse than
#      a session that stays logged in on a wuzapi we cannot currently
#      reach. Attempted best-effort; the outcome is reported, never
#      assumed.
#   1b. Remove the wuzapi USER itself (admin API), while accounts.json
#      still says which wuzapi user this account owns. Logging the session
#      out is not enough: wuzapi keeps the user row, and a later re-link of
#      the same id generates a FRESH token, whereupon `POST /admin/users`
#      answers "already exists", wuzapi keeps serving the OLD token, and
#      every call wa-pair makes afterwards fails with an unknown token —
#      the pairing dies on a JSON parse with no usable explanation. Cleaning
#      up and retrying is the obvious thing to do after a link goes wrong,
#      so it has to work. Like the logout this is best-effort (an
#      unreachable wuzapi must not make a local account permanently
#      un-removable) but, unlike a leftover logged-in session, a leftover
#      user BREAKS the next link — so a failure here is reported loudly, as
#      its own `user_removed ok=false` event and a stderr warning, never
#      swallowed. It runs BEFORE step 2 because step 2 destroys the only
#      record of which wuzapi user this account owned.
#   2. Remove the accounts.json entry. This is the COMMIT POINT: once it
#      is gone, bin/wa-reply already treats every queue entry for this id
#      as UnknownAccount, and the settings screen already stops listing
#      it. Doing this right after logout — before the token is touched —
#      is what rules out the specific bad state called out in the task:
#      a token gone but the account still listed, which makes wa-reply
#      report the wrong, misleading error (MissingToken, "re-pair this")
#      instead of the right one (UnknownAccount, "this account is gone").
#   3. Remove the token from secrets.env.
#   4. Remove the context ring (ctx/<id>/).
#   5. Discard the queue entries for this account.
#
# Steps 3-5 are pure local file operations, each independently idempotent
# (removing something already gone is a no-op), and their order among
# themselves does not matter for correctness — only that they all happen
# after step 2, so a crash before step 2 finishes never lets any of them
# run while wa-reply might still treat the account as configured.
#
# What a crash between each pair of steps leaves, and why a re-run
# converges rather than worsens it:
#
#   before 1: nothing has happened. A re-run starts over. Safe.
#   between 1 and 2: wuzapi may be logged out already; accounts.json,
#     secrets.env, ctx/ and the queue are untouched. A re-run repeats step
#     1 (a harmless repeat of a logout) and proceeds. No data lost.
#   between 2 and 3: the account is gone from accounts.json (queue entries
#     for it are already honestly refused as UnknownAccount, and the
#     settings screen already stops listing it), but the token, ctx ring
#     and queue entries are still on disk. A re-run finds no accounts.json
#     entry, infers the account was already removed (never re-attempts
#     logout — it cannot, the entry that named the wuzapi user is gone,
#     and step 2 only ever runs after step 1 was attempted), and resumes
#     at step 3. No data lost, nothing double-removed.
#   between 3 and 4: token gone (harmless: the account is already gone
#     from accounts.json too, so this never presents as the misleading
#     "missing token" case). A re-run finds no token line to remove
#     (no-op) and resumes at step 4.
#   between 4 and 5: ctx ring gone. A re-run finds no ctx dir (no-op) and
#     resumes at step 5.
#   after 5: fully unlinked. A re-run finds no trace of the account at all
#     and refuses cleanly, exactly like an account that never existed —
#     which, at that point, is what it is. This is the same check used to
#     refuse a genuinely-never-configured id: "no trace anywhere" is what
#     "does not exist" means, and it is indistinguishable from, and
#     correctly treated the same as, "already fully unlinked".
#
# The last account can be unlinked the same way: accounts.json becomes
# `[]`, which sink.accounts.load() and bin/wa-status already treat as a
# valid, empty, configured state.
# --- Why `set -e` is deliberately OFF here ---------------------------------
#
# bin/wa-pair runs under `set -euo pipefail`; this script does not, and that
# is a choice, not an oversight. Two kinds of command here legitimately
# return non-zero and must NOT abort the run:
#
#   * the best-effort remote steps (the wuzapi logout and the wuzapi user
#     removal). A wuzapi that cannot be reached must never leave a local
#     account permanently un-removable — see the ordering notes below.
#   * the `(( ... ))` and `[[ ... ]] &&` idioms used throughout to branch on
#     human vs --json mode, each of which evaluates false on a perfectly
#     normal run.
#
# But that reasoning covers exactly those; it does NOT extend to the local
# MUTATIONS. `set -e` would have caught a failing one — under `set -uo`
# alone a python3 that died printed its traceback to stderr, which the
# settings screen never reads, and the script carried on to emit that
# step's success event, then `done`, then exit 0. An unwritable state
# directory or a full disk produced "Cuenta desvinculada." over an account
# that was still fully present on disk except for its token: the exact
# half-unlinked state this script's ordering exists to prevent, and the one
# that makes wa-reply report the misleading MissingToken.
#
# So rather than switch `set -e` on (which would abort the best-effort
# steps too, and hand the GUI only the trap's generic "exited
# unexpectedly"), EVERY mutation below checks its own exit status and emits
# a terminal `error` naming the step that failed and what it printed. An
# explicit check per step also stops at the right place: the ordering above
# is only a guarantee about crash states if a failed step stops the run
# instead of letting the next one proceed.
set -uo pipefail

JSON_MODE=0
COUNT_ONLY=0
ARGS=()
for _arg in "$@"; do
  case "$_arg" in
    --json) JSON_MODE=1 ;;
    --count-only) COUNT_ONLY=1 ;;
    *) ARGS+=("$_arg") ;;
  esac
done
set -- "${ARGS[@]}"

# --- --json event emission --------------------------------------------------
#
# emit_json(), emit_terminal() and the EXIT trap live in one place —
# bin/lib/wa-common.sh — sourced by both this script and bin/wa-pair. They
# used to be a verbatim copy in each. Sourced here, BEFORE the positional
# args are even parsed, so a missing-argument usage error (an `exit` bash
# takes on its own from `${1:?...}` under `set -u`) is still caught by the
# trap the helper installs.
#
# A failure to source it is FATAL and loud, never a silent downgrade to a
# run with no event stream: the settings screen reading --json would
# otherwise see nothing at all while this script destroyed an account. The
# JSON error line here is a printf of a fixed literal for the same reason
# the trap's fallback is — the helper that would have formatted it is
# exactly what is missing.
WA_EVENT_SCRIPT=wa-unlink
WA_COMMON="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/wa-common.sh"
# shellcheck source=lib/wa-common.sh
if ! source "$WA_COMMON"; then
  echo "error: could not load $WA_COMMON — wa-unlink cannot run without it." >&2
  if (( JSON_MODE )); then
    printf '%s\n' '{"event":"error","reason":"wa-unlink could not load bin/lib/wa-common.sh; the install is incomplete","fatal":true}'
  fi
  exit 1
fi

ACCOUNT_ID="${1:?usage: wa-unlink [--json] [--count-only] <account-id>}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
STATE="${WA_STATE_ROOT:-$HOME/.local/share/omarchy-wa}"
SECRETS="${WA_SECRETS_FILE:-$STATE/secrets.env}"
DATA="${WA_DATA_DIR:-$STATE/state}"
API="${WA_API:-http://127.0.0.1:8080}"

# The account id is validated in exactly one place — accounts.validate_id
# — reached the same way bin/wa-pair reaches it: through
# `wa-reply token-var`, never re-derived here.
if ! wa_token_var "$ROOT/bin/wa-reply" "$ACCOUNT_ID"; then
  # Not `[[ ... ]] && echo`: under `set -e` (bin/wa-pair) a false test as a
  # bare command aborts the script right here, and the EXIT trap would then
  # replace the specific refusal below with its generic fallback.
  if [[ -n "$TOKEN_VAR_ERR" ]]; then
    echo "$TOKEN_VAR_ERR" >&2
  fi
  emit_terminal error reason="${TOKEN_VAR_ERR:-invalid account id: $ACCOUNT_ID}" fatal=true
  exit 1
fi

emit_json validating account="$ACCOUNT_ID"

# One inspection pass, read-only: what exists right now for this account.
# Printed as a single line so bash can read it back without a second
# process per field. Never mutates anything — --count-only stops right
# after this, and the real unlink path uses it only to decide what still
# needs doing (see the ordering notes above for why "not in accounts.json"
# does not by itself mean "nothing to do").
INSPECT_OUT=$(python3 -c '
import json, sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
from sink import accounts, store

data_dir, secrets_path, account_id, token_var = sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5]

accts = accounts.load(data_dir)
entry = accounts.by_id(accts, account_id)
found = entry is not None
# The wuzapi user this account owns, read back rather than assumed to be
# the account id: a single-account install migrated to accounts.json has
# account "personal" whose wuzapi user is "omarchy" (see
# store.migrate_single_account and the RESOLVE_OUT block in bin/wa-pair).
# Deleting a
# wuzapi user named after the account id would miss it entirely and,
# worse, could name the wuzapi user of a DIFFERENT account.
wuzapi_user = (entry or {}).get("wuzapi_user") or (account_id if found else "")

token_present = False
try:
    for line in Path(secrets_path).read_text().splitlines():
        s = line.strip()
        if s.startswith(f"{token_var}=") and "=" in s:
            token_present = True
except FileNotFoundError:
    pass

ctx_present = (Path(data_dir) / "ctx" / account_id).is_dir()

queue = store.load_queue(data_dir)
queue_count = sum(1 for e in queue if e.get("account") == account_id)

# wuzapi_user is printed LAST so a name containing whitespace (nothing
# creates one, but nothing validates it either) lands whole in the last
# field of the `read` in the shell below.
print(int(found), int(token_present), int(ctx_present), queue_count, wuzapi_user)
' "$ROOT" "$DATA" "$SECRETS" "$ACCOUNT_ID" "$TOKEN_VAR") || {
  emit_terminal error reason="could not inspect state for $ACCOUNT_ID: $INSPECT_OUT" fatal=true
  exit 1
}
read -r FOUND TOKEN_PRESENT CTX_PRESENT QUEUE_COUNT WUZAPI_USER <<<"$INSPECT_OUT"

if (( COUNT_ONLY )); then
  emit_terminal count account="$ACCOUNT_ID" pending="$QUEUE_COUNT"
  (( JSON_MODE )) || echo "$QUEUE_COUNT"
  exit 0
fi

if (( ! FOUND )) && (( ! TOKEN_PRESENT )) && (( ! CTX_PRESENT )) && (( QUEUE_COUNT == 0 )); then
  # No trace anywhere: either this id was never configured, or it was
  # already fully unlinked by an earlier, completed run. Either way there
  # is nothing to do, and nothing has been changed by getting here.
  MSG="account '$ACCOUNT_ID' is not configured and has no trace to remove; nothing was changed"
  (( JSON_MODE )) || echo "wa-unlink: $MSG" >&2
  emit_terminal error reason="$MSG" fatal=true
  exit 1
fi

if (( FOUND )); then
  # Sourced whether or not this account has a token line: the admin token
  # used to delete the wuzapi user below lives in the same file and is not
  # this account's.
  if [[ -f "$SECRETS" ]]; then
    # shellcheck disable=SC1090
    source "$SECRETS"
  fi
  if (( TOKEN_PRESENT )); then
    TOKEN_VALUE="${!TOKEN_VAR:-}"
  else
    TOKEN_VALUE=""
  fi

  if [[ -n "$TOKEN_VALUE" ]]; then
    # Best-effort: see the ordering comment above for why an unreachable
    # wuzapi must not block the rest of this script. The outcome is
    # reported, never assumed — a caller that cares can check `ok`.
    # curl's -w '%{http_code}' already prints "000" on its own when the
    # request never got a response (connection refused, timeout, etc) —
    # that output reaches this command substitution regardless of curl's
    # own exit status, so a trailing `|| echo "000"` here would run
    # alongside curl's own already-printed "000" and concatenate a second
    # one onto it (LOGOUT_HTTP="000000"). Only fall back when curl printed
    # nothing at all.
    LOGOUT_HTTP=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 \
      -X POST "$API/session/logout" -H "token: $TOKEN_VALUE" 2>/dev/null)
    [[ -z "$LOGOUT_HTTP" ]] && LOGOUT_HTTP="000"
    if [[ "$LOGOUT_HTTP" == "200" || "$LOGOUT_HTTP" == "201" ]]; then
      (( JSON_MODE )) || echo "wuzapi session logged out for $ACCOUNT_ID"
      emit_json logged_out ok=true
    else
      (( JSON_MODE )) || echo "wa-unlink: could not confirm wuzapi logout for $ACCOUNT_ID (HTTP $LOGOUT_HTTP); continuing with local cleanup anyway" >&2
      emit_json logged_out ok=false http="$LOGOUT_HTTP"
    fi
  else
    (( JSON_MODE )) || echo "wa-unlink: no token on file for $ACCOUNT_ID; nothing to log out, continuing" >&2
    emit_json logged_out ok=false reason="no token on file"
  fi

  # Step 1b — remove the wuzapi user itself. See the ordering notes in the
  # header: a logout alone leaves the user row behind, and a re-link of the
  # same account id then collides with it ("already exists"), keeps the old
  # token, and fails every subsequent call with an unknown token. This is
  # the step that makes unlink-then-relink work.
  #
  # Best-effort like the logout — an unreachable wuzapi must not make the
  # account un-removable locally — but NOT silent: a user left behind is
  # the thing that breaks the next link, so the outcome is always reported,
  # on stderr in human mode and as `user_removed ok=false` in --json, and
  # the settings screen shows it next to the success line.
  if [[ -z "$WUZAPI_USER" ]]; then
    (( JSON_MODE )) || echo "wa-unlink: no wuzapi user recorded for $ACCOUNT_ID; nothing to remove there" >&2
    emit_json user_removed ok=false reason="no wuzapi user recorded for this account"
  elif [[ -z "${WUZAPI_ADMIN_TOKEN:-}" ]]; then
    (( JSON_MODE )) || echo "wa-unlink: no WUZAPI_ADMIN_TOKEN in $SECRETS; the wuzapi user '$WUZAPI_USER' was NOT removed. Re-linking '$ACCOUNT_ID' will collide with it — remove it by hand first." >&2
    emit_json user_removed ok=false user="$WUZAPI_USER" reason="no WUZAPI_ADMIN_TOKEN in $SECRETS; re-linking this account will collide with the leftover wuzapi user"
  else
    # One python3 process for the whole GET-find-DELETE: the user's
    # wuzapi-internal id (wuzapi's own GenerateRandomID, not the account id
    # and not the token) has to be looked up by name before it can be
    # deleted, and doing that in bash would mean a second curl plus a JSON
    # parse in the shell. Prints one word/line describing the outcome;
    # exit 0 means the user is gone (or was never there), non-zero means it
    # may still be there.
    USER_DEL_OUT=$(python3 -c '
import json, sys, urllib.error, urllib.request

api, admin_token, name = sys.argv[1], sys.argv[2], sys.argv[3]

def call(method, path):
    req = urllib.request.Request(api.rstrip("/") + path, method=method,
                                 headers={"Authorization": admin_token})
    with urllib.request.urlopen(req, timeout=5) as resp:
        return resp.status, resp.read().decode("utf-8", "replace")

try:
    status, body = call("GET", "/admin/users")
except urllib.error.HTTPError as exc:
    print(f"could not list wuzapi users (HTTP {exc.code})")
    sys.exit(1)
except Exception as exc:
    print(f"could not reach wuzapi to list users: {exc}")
    sys.exit(1)

try:
    payload = json.loads(body)
except ValueError:
    print("wuzapi returned a non-JSON user list")
    sys.exit(1)

rows = payload.get("data") if isinstance(payload, dict) else payload
if not isinstance(rows, list):
    print("wuzapi returned an unexpected user list shape")
    sys.exit(1)

match = next((r for r in rows
              if isinstance(r, dict) and r.get("name") == name), None)
if match is None:
    # Already gone: a re-run after a crash, or a user wuzapi never had.
    # Both mean the next link will not collide, which is all this step is
    # for, so it is a success.
    print("absent")
    sys.exit(0)

user_id = match.get("id")
if user_id in (None, ""):
    print("wuzapi listed the user without an id")
    sys.exit(1)

try:
    status, _ = call("DELETE", f"/admin/users/{user_id}")
except urllib.error.HTTPError as exc:
    if exc.code == 404:
        print("absent")
        sys.exit(0)
    print(f"wuzapi refused to delete the user (HTTP {exc.code})")
    sys.exit(1)
except Exception as exc:
    print(f"could not reach wuzapi to delete the user: {exc}")
    sys.exit(1)

if status in (200, 201, 202, 204):
    print("removed")
    sys.exit(0)
print(f"wuzapi returned HTTP {status} deleting the user")
sys.exit(1)
' "$API" "$WUZAPI_ADMIN_TOKEN" "$WUZAPI_USER" 2>&1)
    if (( $? == 0 )); then
      (( JSON_MODE )) || echo "wuzapi user '$WUZAPI_USER' removed ($USER_DEL_OUT)"
      emit_json user_removed ok=true user="$WUZAPI_USER"
    else
      (( JSON_MODE )) || echo "wa-unlink: the wuzapi user '$WUZAPI_USER' was NOT removed: $USER_DEL_OUT. Local cleanup continues, but re-linking '$ACCOUNT_ID' will collide with it — remove it by hand first." >&2
      emit_json user_removed ok=false user="$WUZAPI_USER" reason="$USER_DEL_OUT"
    fi
  fi

  # The commit point: from here on, wa-reply already refuses this
  # account's queue entries as unknown, and the settings screen already
  # stops listing it, even though secrets.env/ctx/queue may still have
  # residue for a moment.
  STEP_OUT=$(python3 -c '
import json, sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
from sink import accounts, store

data_dir, account_id = sys.argv[2], sys.argv[3]
path = Path(data_dir) / "accounts.json"
remaining = [a for a in accounts.load(data_dir) if a.get("id") != account_id]
store.atomic_write(path, json.dumps(remaining, ensure_ascii=False))
' "$ROOT" "$DATA" "$ACCOUNT_ID" 2>&1) || {
    # Checked, not assumed: this is the commit point, and an unwritable
    # state directory or a full disk used to print a traceback to stderr
    # (which the settings screen never reads) and then let the run emit
    # account_removed, done, exit 0 over an account still fully present.
    (( JSON_MODE )) || echo "wa-unlink: could not remove $ACCOUNT_ID from accounts.json; nothing further was changed: $STEP_OUT" >&2
    emit_terminal error reason="could not remove $ACCOUNT_ID from accounts.json (nothing further was changed): $STEP_OUT" fatal=true
    exit 1
  }
  (( JSON_MODE )) || echo "accounts.json: removed $ACCOUNT_ID"
  emit_json account_removed account="$ACCOUNT_ID"
fi

# From here on, every step is a pure local removal, idempotent on its own:
# a re-run after a crash inside any one of these just finds nothing left
# to remove and moves to the next.

STEP_OUT=$(python3 -c '
import sys
from pathlib import Path
token_var, secrets_path = sys.argv[1], sys.argv[2]
p = Path(secrets_path)
try:
    lines = p.read_text().splitlines()
except FileNotFoundError:
    sys.exit(0)
kept = [ln for ln in lines if not ln.strip().startswith(f"{token_var}=")]
if kept != lines:
    text = "\n".join(kept)
    if text and not text.endswith("\n"):
        text += "\n"
    tmp = p.with_suffix(p.suffix + ".tmp-wa-unlink")
    tmp.write_text(text)
    tmp.chmod(0o600)
    tmp.replace(p)
' "$TOKEN_VAR" "$SECRETS" 2>&1) || {
  (( JSON_MODE )) || echo "wa-unlink: could not remove $TOKEN_VAR from $SECRETS: $STEP_OUT" >&2
  emit_terminal error reason="could not remove $TOKEN_VAR from $SECRETS; the account is already out of accounts.json, so re-run wa-unlink $ACCOUNT_ID once the cause is fixed: $STEP_OUT" fatal=true
  exit 1
}
(( JSON_MODE )) || echo "secrets.env: removed $TOKEN_VAR"
emit_json token_removed account="$ACCOUNT_ID"

STEP_OUT=$(python3 -c '
import shutil, sys
from pathlib import Path
data_dir, account_id = sys.argv[1], sys.argv[2]
target = Path(data_dir) / "ctx" / account_id
shutil.rmtree(target, ignore_errors=True)
# ignore_errors=True swallows a permission failure as readily as a missing
# directory, so the two are told apart here rather than reported as the
# same success: the whole point of this pass is that a step which did not
# happen must not be announced as if it had.
if target.exists():
    sys.exit(f"{target} still exists after rmtree")
' "$DATA" "$ACCOUNT_ID" 2>&1) || {
  (( JSON_MODE )) || echo "wa-unlink: could not remove the context ring for $ACCOUNT_ID: $STEP_OUT" >&2
  emit_terminal error reason="could not remove the context ring for $ACCOUNT_ID; the account is already out of accounts.json, so re-run wa-unlink $ACCOUNT_ID once the cause is fixed: $STEP_OUT" fatal=true
  exit 1
}
(( JSON_MODE )) || echo "ctx/$ACCOUNT_ID: removed"
emit_json context_removed account="$ACCOUNT_ID"

DISCARD_OUT=$(python3 -c '
import json, sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
from sink import store

data_dir, account_id = sys.argv[2], sys.argv[3]
queue = store.load_queue(data_dir)
kept = [e for e in queue if e.get("account") != account_id]
discarded = len(queue) - len(kept)
store.atomic_write(Path(data_dir) / "queue.json", json.dumps(kept, ensure_ascii=False))
print(discarded)
' "$ROOT" "$DATA" "$ACCOUNT_ID" 2>&1) || {
  (( JSON_MODE )) || echo "wa-unlink: could not discard the queue entries for $ACCOUNT_ID: $DISCARD_OUT" >&2
  emit_terminal error reason="could not discard the queue entries for $ACCOUNT_ID; the account is already out of accounts.json, so re-run wa-unlink $ACCOUNT_ID once the cause is fixed: $DISCARD_OUT" fatal=true
  exit 1
}
DISCARDED="$DISCARD_OUT"
if [[ ! "$DISCARDED" =~ ^[0-9]+$ ]]; then
  # A zero exit but something other than a bare count on stdout (a warning
  # printed alongside it, say) means this run cannot honestly say how many
  # entries it discarded — and `done` carries that number to the UI.
  (( JSON_MODE )) || echo "wa-unlink: unexpected output while discarding the queue entries for $ACCOUNT_ID: $DISCARD_OUT" >&2
  emit_terminal error reason="unexpected output while discarding the queue entries for $ACCOUNT_ID: $DISCARD_OUT" fatal=true
  exit 1
fi
(( JSON_MODE )) || echo "queue: discarded $DISCARDED entrie(s) for $ACCOUNT_ID"
emit_json queue_discarded rows="$DISCARDED"

(( JSON_MODE )) || echo "wa-unlink: $ACCOUNT_ID fully unlinked; $DISCARDED queue entrie(s) discarded"
emit_terminal done discarded="$DISCARDED"
exit 0
